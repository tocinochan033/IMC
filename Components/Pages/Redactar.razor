@page "/redactar"
@using Supabase.Gotrue.Exceptions
@using Supabase.Postgrest.Exceptions
@inject SupabaseService SupabaseService
@inject NavigationManager Navigation
@inject ILogger<Redactar> Logger

<PageTitle>Nuevo mensaje</PageTitle>

<section class="compose-page" aria-labelledby="compose-title">
    <header class="compose-header">
        <div class="compose-heading">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z" />
            </svg>
            <h1 id="compose-title">Redactar mensaje</h1>
        </div>
    </header>

    @if (isLoadingDraft)
    {
        <p class="compose-status">Cargando borrador...</p>
    }
    else
    {
    <form class="compose-form" @onsubmit="Enviar" @onsubmit:preventDefault>
        <div class="compose-field">
            <label for="destinatario">Para</label>
            <input id="destinatario" type="email" autocomplete="email" placeholder="Correo del destinatario"
                   @bind="Destinatario" required />
        </div>

        <div class="compose-field">
            <label for="asunto">Asunto</label>
            <input id="asunto" type="text" placeholder="Asunto del mensaje" @bind="Asunto" />
        </div>

        <div class="compose-body">
            <label class="visually-hidden" for="cuerpo">Mensaje</label>
            <textarea id="cuerpo" placeholder="Escribe tu mensaje..." @bind="Cuerpo" required></textarea>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="compose-error" role="alert">@errorMessage</p>
        }

        <footer class="compose-footer">
            <button type="submit" class="compose-send" disabled="@(isSending || isSavingDraft)">
                @if (isSending)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>Enviando...</span>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="m22 2-7 20-4-9-9-4Z" />
                        <path d="M22 2 11 13" />
                    </svg>
                    <span>Enviar</span>
                }
            </button>
            <button type="button" class="compose-save" @onclick="Guardar" disabled="@(isSending || isSavingDraft)">
                @if (isSavingDraft)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" />
                        <path d="M17 21v-8H7v8M7 3v5h8" />
                    </svg>
                    <span>Guardar borrador</span>
                }
            </button>
        </footer>
    </form>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "destinatario")]
    public string? DestinatarioInicial { get; set; }

    [SupplyParameterFromQuery(Name = "asunto")]
    public string? AsuntoInicial { get; set; }

    [SupplyParameterFromQuery(Name = "cuerpo")]
    public string? CuerpoInicial { get; set; }

    [SupplyParameterFromQuery(Name = "parentMessageId")]
    public Guid? ParentMessageId { get; set; }

    [SupplyParameterFromQuery(Name = "draftId")]
    public Guid? DraftId { get; set; }

    private string Destinatario { get; set; } = string.Empty;
    private string Asunto { get; set; } = string.Empty;
    private string Cuerpo { get; set; } = string.Empty;
    private bool isSending;
    private bool isSavingDraft;
    private bool isLoadingDraft;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (DraftId is not { } draftId)
        {
            Destinatario = DestinatarioInicial ?? string.Empty;
            Asunto = AsuntoInicial ?? string.Empty;
            Cuerpo = CuerpoInicial ?? string.Empty;
            errorMessage = null;
            return;
        }

        isLoadingDraft = true;
        errorMessage = null;
        try
        {
            var draft = await SupabaseService.ObtenerBorradorAsync(draftId);
            if (draft is null)
            {
                errorMessage = "No se encontró el borrador o ya no está disponible.";
                return;
            }

            Destinatario = draft.Value.Message.DraftRecipientEmail ?? string.Empty;
            Asunto = draft.Value.Message.Subject;
            Cuerpo = draft.Value.Message.Body;
            ParentMessageId = draft.Value.Message.ParentMessageId;
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "No hay una sesión válida para abrir el borrador {DraftId}.", draftId);
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo cargar el borrador {DraftId}.", draftId);
            errorMessage = "No se pudo cargar el borrador. Inténtalo de nuevo.";
        }
        catch (PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase devolvió un error al consultar el borrador {DraftId}.", draftId);
            errorMessage = "Ocurrió un error al cargar el borrador.";
        }
        finally
        {
            isLoadingDraft = false;
        }
    }

    private async Task Enviar()
    {
        if (isSending)
        {
            return;
        }

        isSending = true;
        errorMessage = null;

        try
        {
            await SupabaseService.Initialization;
            if (!Guid.TryParse(SupabaseService.Client.Auth.CurrentSession?.User?.Id, out var senderId))
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var result = await SupabaseService.EnviarCorreo(
                senderId,
                Destinatario,
                Asunto,
                Cuerpo,
                ParentMessageId,
                DraftId);
            if (result == ResultadoEnvioCorreo.DestinatarioNoValido)
            {
                errorMessage = "No existe un usuario con ese correo destinatario.";
                return;
            }

            Navigation.NavigateTo("/bandeja");
        }
        catch (GotrueException exception)
        {
            Logger.LogError(exception, "Supabase Auth rechazó el envío del mensaje.");
            errorMessage = "Tu sesión no es válida. Inicia sesión de nuevo.";
        }
        catch (PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase devolvió un error al enviar el mensaje.");
            errorMessage = "No se pudo enviar el mensaje. Inténtalo de nuevo.";
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo conectar con Supabase para enviar el mensaje.");
            errorMessage = "No se pudo conectar con el servicio. Inténtalo de nuevo.";
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "No se pudo enviar el mensaje por falta de sesión válida.");
            errorMessage = "Tu sesión no es válida. Inicia sesión de nuevo.";
            Navigation.NavigateTo("/login");
        }
        finally
        {
            isSending = false;
        }
    }

    private async Task Guardar()
    {
        if (isSavingDraft || isSending)
        {
            return;
        }

        isSavingDraft = true;
        errorMessage = null;

        try
        {
            await SupabaseService.Initialization;
            if (!Guid.TryParse(SupabaseService.Client.Auth.CurrentSession?.User?.Id, out var senderId))
            {
                Navigation.NavigateTo("/login");
                return;
            }

            DraftId = await SupabaseService.GuardarBorrador(
                senderId,
                Destinatario,
                Asunto,
                Cuerpo,
                DraftId,
                ParentMessageId);
            Navigation.NavigateTo("/borradores");
        }
        catch (GotrueException exception)
        {
            Logger.LogError(exception, "Supabase Auth rechazó guardar el borrador.");
            errorMessage = "Tu sesión no es válida. Inicia sesión de nuevo.";
        }
        catch (PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase devolvió un error al guardar el borrador.");
            errorMessage = "No se pudo guardar el borrador. Inténtalo de nuevo.";
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo conectar con Supabase para guardar el borrador.");
            errorMessage = "No se pudo conectar con el servicio. Inténtalo de nuevo.";
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "No se pudo guardar el borrador por falta de sesión válida.");
            errorMessage = "Tu sesión no es válida. Inicia sesión de nuevo.";
            Navigation.NavigateTo("/login");
        }
        finally
        {
            isSavingDraft = false;
        }
    }
}
