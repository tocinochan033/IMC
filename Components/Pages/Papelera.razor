@page "/papelera"
@using IMC_.Models
@using IMC_.Services
@inject SupabaseService SupabaseService
@inject NavigationManager Navigation
@inject ILogger<Papelera> Logger

<PageTitle>Papelera</PageTitle>

<MailboxFolderView Title="Papelera"
                   EmptyText="No hay mensajes en la papelera."
                   SearchInputId="buscar-papelera"
                   Messages="@mensajes"
                   IsLoading="@isLoading"
                   ErrorMessage="@errorMessage"
                   SearchTerm="@terminoBusqueda"
                   SearchTermChanged="@BuscarMensajes"
                   ShowDeletePermanently="true"
                   OnDeletePermanently="@EliminarPermanentemente"
                   OnEmptyTrash="@VaciarPapelera" />

@code {
    private List<(MailboxEntry Entry, Message Message)> mensajes = [];
    private bool isLoading = true;
    private string terminoBusqueda = string.Empty;
    private string? errorMessage;
    private int searchRequestId;
    private readonly HashSet<Guid> deletingEntryIds = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            mensajes = await SupabaseService.ObtenerPapeleraAsync();
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "No hay una sesión válida para consultar la papelera.");
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudieron cargar los mensajes de la papelera desde Supabase.");
            errorMessage = "No se pudieron cargar los mensajes de la papelera. Inténtalo de nuevo.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase devolvió un error al consultar la papelera.");
            errorMessage = "Ocurrió un error al consultar la papelera.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task BuscarMensajes(string termino)
    {
        terminoBusqueda = termino;
        var requestId = ++searchRequestId;
        errorMessage = null;

        try
        {
            List<(MailboxEntry Entry, Message Message)> resultados;
            if (string.IsNullOrWhiteSpace(termino))
            {
                resultados = await SupabaseService.ObtenerPapeleraAsync();
            }
            else
            {
                await SupabaseService.Initialization;
                if (!Guid.TryParse(SupabaseService.Client.Auth.CurrentSession?.User?.Id, out var userId))
                {
                    throw new InvalidOperationException("Se requiere una sesión autenticada para buscar mensajes.");
                }

                resultados = await SupabaseService.BuscarMensajes(userId, termino, "trash");
            }

            if (requestId == searchRequestId)
            {
                mensajes = resultados;
            }
        }
        catch (InvalidOperationException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogWarning(exception, "No hay una sesión válida para buscar en la papelera.");
                Navigation.NavigateTo("/login");
            }
        }
        catch (HttpRequestException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogError(exception, "No se pudieron buscar mensajes de la papelera desde Supabase.");
                errorMessage = "No se pudieron buscar los mensajes de la papelera. Inténtalo de nuevo.";
            }
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogError(exception, "Supabase devolvió un error al buscar en la papelera.");
                errorMessage = "Ocurrió un error al buscar en la papelera.";
            }
        }
    }

    private async Task EliminarPermanentemente(Guid mailboxEntryId)
    {
        if (!deletingEntryIds.Add(mailboxEntryId))
        {
            return;
        }

        errorMessage = null;
        try
        {
            var eliminado = await SupabaseService.EliminarPermanentementeDePapelera(mailboxEntryId);
            if (eliminado)
            {
                mensajes.RemoveAll(mensaje => mensaje.Entry.Id == mailboxEntryId);
            }
            else
            {
                Logger.LogWarning(
                    "No se eliminó la entrada {MailboxEntryId}: no existe en la papelera del usuario actual.",
                    mailboxEntryId);
                errorMessage = "El mensaje ya no está en tu papelera o no se pudo encontrar.";
            }
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "La sesión no es válida para eliminar la entrada {MailboxEntryId}.", mailboxEntryId);
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo eliminar permanentemente la entrada {MailboxEntryId}.", mailboxEntryId);
            errorMessage = "No se pudo eliminar el mensaje permanentemente. Inténtalo de nuevo.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase rechazó eliminar la entrada {MailboxEntryId}.", mailboxEntryId);
            errorMessage = "No se pudo eliminar el mensaje permanentemente. Inténtalo de nuevo.";
        }
        finally
        {
            deletingEntryIds.Remove(mailboxEntryId);
        }
    }

    private async Task VaciarPapelera()
    {
        if (deletingEntryIds.Count > 0)
        {
            return;
        }

        errorMessage = null;
        try
        {
            var eliminadas = await SupabaseService.VaciarPapelera();
            mensajes.Clear();
            Logger.LogInformation("Se eliminaron {MailboxEntryCount} entradas de la papelera del usuario.", eliminadas);
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "La sesión no es válida para vaciar la papelera.");
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo vaciar la papelera desde Supabase.");
            errorMessage = "No se pudo vaciar la papelera. Inténtalo de nuevo.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase rechazó vaciar la papelera.");
            errorMessage = "No se pudo vaciar la papelera. Inténtalo de nuevo.";
        }
    }
}
