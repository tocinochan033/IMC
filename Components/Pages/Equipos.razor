    private async Task CrearEquipoAsync()
    {
        if (isCheckingTeamCreationPermission || !string.IsNullOrWhiteSpace(teamCreationPermissionError) || !canCreateTeam) return;
        var nombre = nombreNuevoEquipo.Trim();
        if (isCreatingTeam || string.IsNullOrWhiteSpace(nombre)) return;

        isCreatingTeam = true;
        errorMessage = null;
        memberValidationMessage = null;
        feedbackMessage = null;
        try
        {
            Team nuevoEquipo;
            try
            {
                nuevoEquipo = await SupabaseService.CrearEquipo(
                    nombre,
                    string.IsNullOrWhiteSpace(descripcionNuevoEquipo) ? null : descripcionNuevoEquipo.Trim());
            }
            catch (InvalidOperationException exception)
            {
                Logger.LogWarning(exception, "No hay una sesión válida para crear un equipo.");
                Navigation.NavigateTo("/login");
                return;
            }
            catch (UnauthorizedAccessException exception)
            {
                Logger.LogWarning(exception, "Se rechazó la creación de un equipo por falta de permisos.");
                canCreateTeam = false;
                teamCreationPermissionError = null;
                return;
            }
            catch (HttpRequestException exception)
            {
                Logger.LogError(exception, "No se pudo crear un equipo desde Supabase.");
                errorMessage = "No se pudo crear el equipo. Comprueba tu conexión e inténtalo de nuevo.";
                return;
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Se creó un equipo, pero no se pudo actualizar la lista.");
                teamsError = "No se pudieron actualizar tus equipos. Inténtalo de nuevo.";
                await CargarEquiposAsync();
                return;
            }

            nombreNuevoEquipo = string.Empty;
            descripcionNuevoEquipo = string.Empty;
            pendingTeamCreationConfirmation = $"El equipo «{nuevoEquipo.Name}» se creó correctamente. Solo falló la actualización de la lista; usa «Reintentar cargar equipos» para volver a intentarlo.";

            try
            {
                await SeleccionarEquipoAsync(nuevoEquipo.Id);
                feedbackMessage = $"Se creó el equipo «{nuevoEquipo.Name}».";
            }
            finally
            {
                isCreatingTeam = false;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ocurrió un error inesperado al crear un equipo.");
            errorMessage = "No se pudo crear el equipo. Inténtalo de nuevo más tarde.";
            isCreatingTeam = false;
        }
    }

    private void AbrirNuevaTarea()
    {
        if (isTaskOperationInFlight || !esJefeDelEquipo) return;
        ResetTaskForm();
        isTaskFormOpen = true;
        pageError = null;
    }

    private void EditarTarea(TeamTask task)
    {
        if (!membersLoaded || isTaskOperationInFlight || selectedTeamId != task.TeamId || !esJefeDelEquipo) return;

        editingTaskId = task.Id;
        tituloTarea = task.Title;
        descripcionTarea = task.Description ?? "";
        fechaLimiteTarea = task.DueAt?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";
        estadoEdicion = task.Status;
        asignadosTarea.Clear();
        var asignadosDescartados = false;
        foreach (var assignedId in ObtenerAsignadosDe(task))
        {
            if (miembros.Any(member => member.Id == assignedId))
            {
                asignadosTarea.Add(assignedId);
            }
            else
            {
                asignadosDescartados = true;
            }
        }
        if (asignadosDescartados)
        {
            feedback = "Al editar se quitó de la asignación a personas que ya no están en el equipo.";
        }
        isTaskFormOpen = true;
        pageError = null;
    }

    private async Task GuardarTareaAsync()
    {
        if (EquipoSeleccionado is not { } team || string.IsNullOrWhiteSpace(tituloTarea) ||
            !membersLoaded || isLoadingMembers || membersError is not null || isTaskOperationInFlight ||
            !esJefeDelEquipo) return;

        var teamId = team.Id;
        var requestId = selectionRequestId;

        var asignadosDescartados = asignadosTarea.Any(id => !miembros.Any(member => member.Id == id));
        var asignados = miembros.Where(member => asignadosTarea.Contains(member.Id)).Select(member => member.Id).ToList();

        Guid? assigneeId = null;
        if (asignados.Count > 0)
        {
            var principalActual = editingTaskId is Guid editingId
                ? tareas.FirstOrDefault(item => item.Id == editingId)?.AssigneeId
                : null;
            assigneeId = principalActual is Guid principal && asignados.Contains(principal)
                ? principal
                : asignados[0];
        }

        isTaskOperationInFlight = true;
        pageError = null;
        feedback = null;
        DateTimeOffset? dueAt = DateOnly.TryParse(fechaLimiteTarea, CultureInfo.InvariantCulture, out var dueDate)
            ? new DateTimeOffset(dueDate.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero)
            : null;

        try
        {
            if (editingTaskId is Guid taskId)
            {
                await SupabaseService.ActualizarTarea(teamId, taskId, tituloTarea.Trim(),
                    string.IsNullOrWhiteSpace(descripcionTarea) ? null : descripcionTarea.Trim(),
                    assigneeId, dueAt, asignados);
                if (selectedTeamId == teamId && selectionRequestId == requestId)
                {
                    var task = tareas.FirstOrDefault(item => item.Id == taskId && item.TeamId == teamId);
                    if (task is not null)
                    {
                        task.Title = tituloTarea.Trim();
                        task.Description = string.IsNullOrWhiteSpace(descripcionTarea) ? null : descripcionTarea.Trim();
                        task.AssigneeId = assigneeId;
                        task.DueAt = dueAt;
                    }
                    asignadosPorTarea[taskId] = [.. asignados];
                    feedback = asignadosDescartados
                        ? "Se guardaron los cambios. Las personas que ya no están en el equipo se quitaron de la asignación."
                        : "Se guardaron los cambios de la tarea.";
                    CerrarFormularioTrasGuardar();
                }
            }
            else
            {
                var created = await SupabaseService.CrearTarea(teamId, tituloTarea.Trim(),
                    string.IsNullOrWhiteSpace(descripcionTarea) ? null : descripcionTarea.Trim(),
                    assigneeId, dueAt, asignados);
                if (selectedTeamId == teamId && selectionRequestId == requestId)
                {
                    tareas.Add(created);
                    asignadosPorTarea[created.Id] = [.. asignados];
                    feedback = "Se creó la tarea.";
                    CerrarFormularioTrasGuardar();
                }
            }
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase rechazó guardar la tarea del equipo {TeamId}.", teamId);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                pageError = "Supabase rechazó el guardado (permisos RLS o tablas del módulo de equipos). Revisa el estado de la base de datos y vuelve a intentarlo.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "No se pudo guardar la tarea del equipo {TeamId}.", teamId);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                pageError = "No se pudo guardar la tarea. Inténtalo de nuevo más tarde.";
            }
        }
        finally
        {
            isTaskOperationInFlight = false;
        }
    }

    private async Task CambiarEstadoAsync(TeamTask task, string status)
    {
        if (status is not ("todo" or "in_progress" or "done") || task.Status == status ||
            isTaskOperationInFlight || !membersLoaded || EquipoSeleccionado?.Id != task.TeamId ||
            !PuedeCambiarEstado(task)) return;

        var teamId = task.TeamId;
        var requestId = selectionRequestId;
        var previousStatus = task.Status;
        isTaskOperationInFlight = true;
        task.Status = status;
        pageError = null;
        StateHasChanged();
        try
        {
            await SupabaseService.ActualizarEstadoTarea(task.Id, status);
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogWarning(exception, "La base de datos rechazó el cambio de estado de la tarea {TaskId}.", task.Id);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                var rejectedTask = tareas.FirstOrDefault(item => item.Id == task.Id && item.TeamId == teamId);
                if (rejectedTask is not null) rejectedTask.Status = previousStatus;
                pageError = "La base de datos rechazó el cambio de estado: solo el creador del equipo o la persona asignada pueden actualizar esta tarea.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "No se pudo cambiar el estado de la tarea {TaskId}.", task.Id);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                pageError = "No se pudo cambiar el estado. Inténtalo de nuevo más tarde.";
            }
        }
        finally
        {
            isTaskOperationInFlight = false;
        }
    }

    private async Task SolicitarEliminarAsync(TeamTask task)
    {
        if (isTaskOperationInFlight || !membersLoaded || EquipoSeleccionado?.Id != task.TeamId || !esJefeDelEquipo) return;
        pageError = null;
        if (pendingDeleteId == task.Id)
        {
            await EliminarTareaAsync(task);
        }
        else
        {
            pendingDeleteId = task.Id;
        }
    }

    private async Task EliminarTareaAsync(TeamTask task)
    {
        var teamId = task.TeamId;
        var requestId = selectionRequestId;
        isTaskOperationInFlight = true;
        try
        {
            await SupabaseService.EliminarTarea(teamId, task.Id);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                tareas.RemoveAll(item => item.Id == task.Id && item.TeamId == teamId);
                asignadosPorTarea.Remove(task.Id);
                feedback = "Se eliminó la tarea.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "No se pudo eliminar la tarea {TaskId}.", task.Id);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                pageError = "No se pudo eliminar la tarea. Inténtalo de nuevo más tarde.";
            }
        }
        finally
        {
            isTaskOperationInFlight = false;
        }
    }

    private async Task AgregarMiembroAsync()
    {
        if (!puedeInvitarAlEquipo || EquipoSeleccionado is not { } team ||
            string.IsNullOrWhiteSpace(memberEmail) || isMemberInviteInFlight) return;

        var teamId = team.Id;
        var requestId = selectionRequestId;
        isMemberInviteInFlight = true;
        memberInviteError = null;
        memberInviteFeedback = null;
        try
        {
            var resultado = await SupabaseService.AgregarMiembro(teamId, memberEmail.Trim());
            if (selectedTeamId != teamId || selectionRequestId != requestId) return;

            switch (resultado)
            {
                case ResultadoAgregarMiembro.Agregado:
                    memberEmail = "";
                    memberInviteFeedback = "Se agregó el miembro al equipo.";
                    await CargarMiembrosAsync(teamId, requestId);
                    break;
                case ResultadoAgregarMiembro.CuentaNoEncontrada:
                    memberInviteError = "No se encontró una cuenta con ese correo electrónico.";
                    break;
                case ResultadoAgregarMiembro.YaEsMiembro:
                    memberInviteError = "Esa cuenta ya pertenece al equipo.";
                    break;
                case ResultadoAgregarMiembro.NoAutorizado:
                    memberInviteError = "Solo la persona que creó el equipo puede agregar miembros.";
                    break;
            }
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase rechazó agregar un miembro al equipo {TeamId}.", teamId);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                memberInviteError = "No se pudo agregar a la persona. Puede que no tengas permisos para invitar a miembros.";
            }
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "No hay una sesión válida para agregar miembros al equipo {TeamId}.", teamId);
            if (selectedTeamId == teamId && selectionRequestId == requestId) Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo agregar un miembro al equipo {TeamId}.", teamId);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                memberInviteError = "No se pudo agregar a la persona. Comprueba tu conexión e inténtalo de nuevo.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ocurrió un error inesperado al agregar un miembro al equipo {TeamId}.", teamId);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                memberInviteError = "No se pudo agregar a la persona. Inténtalo de nuevo más tarde.";
            }
        }
        finally
        {
            isMemberInviteInFlight = false;
        }
    }

