@page "/equipos"
@using IMC_.Models
@using IMC_.Services
@using System.Globalization
@inject SupabaseService SupabaseService
@inject ChatService ChatService
@inject NavigationManager Navigation
@inject ILogger<Equipos> Logger

<PageTitle>Equipos</PageTitle>

<section class="teams-page" aria-labelledby="teams-title">
    <header class="teams-header">
        <div>
            <p class="teams-eyebrow">Colaboración</p>
            <h1 id="teams-title">Equipos</h1>
            <p class="teams-intro">Organiza el trabajo y comparte tus equipos con otras personas.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="teams-alert teams-alert-error" role="alert">@errorMessage</p>
    }
    @if (!string.IsNullOrWhiteSpace(memberValidationMessage))
    {
        <p class="teams-alert teams-alert-error" role="status">@memberValidationMessage</p>
    }
    @if (!string.IsNullOrWhiteSpace(feedbackMessage))
    {
        <p class="teams-alert teams-alert-success" role="status">@feedbackMessage</p>
    }

    @if (isLoadingTeams)
    {
        <p class="teams-status" role="status">Cargando tus equipos...</p>
    }
    else if (!string.IsNullOrWhiteSpace(teamsError))
    {
        <div class="teams-load-error">
            <p class="teams-status" role="alert">@teamsError</p>
            <button type="button" class="primary-button" @onclick="CargarEquiposAsync">Reintentar cargar equipos</button>
        </div>
    }
    else
    {
        <div class="teams-layout">
            <aside class="teams-sidebar" aria-label="Tus equipos">
                <div class="section-heading">
                    <div>
                        <h2>Mis equipos</h2>
                        <span class="teams-count">@equipos.Count @(equipos.Count == 1 ? "equipo" : "equipos")</span>
                    </div>
                </div>

                @if (equipos.Count == 0)
                {
                    <p class="teams-empty-list">Todavía no tienes equipos. Crea uno para empezar.</p>
                }
                else
                {
                    <ul class="team-list">
                        @foreach (var equipo in equipos)
                        {
                            var isSelected = selectedTeamId == equipo.Id;
                            <li>
                                <button type="button" class="team-option @(isSelected ? "selected" : string.Empty)"
                                        aria-current="@(isSelected ? "true" : null)" @onclick="() => SeleccionarEquipoAsync(equipo.Id)">
                                    <span class="team-avatar" aria-hidden="true">@Iniciales(equipo.Name)</span>
                                    <span class="team-option-copy">
                                        <span class="team-option-name">@equipo.Name</span>
                                        <span class="team-option-description">@(string.IsNullOrWhiteSpace(equipo.Description) ? "Sin descripción" : equipo.Description)</span>
                                    </span>
                                    <span class="team-chevron" aria-hidden="true">›</span>
                                </button>
                            </li>
                        }
                    </ul>
                }

                @if (isCheckingTeamCreationPermission)
                {
                    <p class="team-permission-notice" role="status">Verificando permisos para crear equipos...</p>
                }
                else if (!string.IsNullOrWhiteSpace(teamCreationPermissionError))
                {
                    <div class="team-permission-notice" role="alert">
                        <p>@teamCreationPermissionError</p>
                        <button type="button" class="permission-retry-button" @onclick="CargarPermisosCrearEquipoAsync">Reintentar</button>
                    </div>
                }
                else if (canCreateTeam)
                {
                    <form class="create-team-form" @onsubmit="CrearEquipoAsync" @onsubmit:preventDefault>
                        <h3>Crear un equipo</h3>
                        <label for="team-name">Nombre</label>
                        <input id="team-name" type="text" @bind="nombreNuevoEquipo" maxlength="100" placeholder="Ej. Diseño de producto" required />
                        <label for="team-description">Descripción <span>(opcional)</span></label>
                        <textarea id="team-description" @bind="descripcionNuevoEquipo" maxlength="300" rows="2" placeholder="¿En qué trabajará este equipo?"></textarea>
                        <button type="submit" class="primary-button" disabled="@isCreatingTeam">@(isCreatingTeam ? "Creando..." : "Crear equipo")</button>
                    </form>
                }
                else
                {
                    <p class="team-permission-notice" role="status">Solo los perfiles con rol team_manager, project_manager o admin pueden crear equipos. Puedes seguir consultando tus equipos.</p>
                }
            </aside>

            <section class="team-detail" aria-label="Detalles del equipo seleccionado">
                @if (EquipoSeleccionado is null)
                {
                    <div class="detail-empty">
                        <span class="empty-mark" aria-hidden="true">+</span>
                        <h2>Tu espacio de equipo</h2>
                        <p>Selecciona un equipo para ver a sus miembros.</p>
                    </div>
                }
                else
                {
                    <header class="detail-header">
                        <div class="detail-team-avatar" aria-hidden="true">@Iniciales(EquipoSeleccionado.Name)</div>
                        <div>
                            <p class="teams-eyebrow">Equipo</p>
                            <h2>@EquipoSeleccionado.Name</h2>
                            @if (!string.IsNullOrWhiteSpace(EquipoSeleccionado.Description))
                            {
                                <p class="detail-description">@EquipoSeleccionado.Description</p>
                            }
                        </div>
                        <div class="team-meta">
                            <span>@(esJefeDelEquipo ? "Creador" : "Miembro")</span>
                            <small>@(isLoadingMembers ? "Cargando miembros…" : membersError is not null ? "Miembros no disponibles" : $"{miembros.Count} {(miembros.Count == 1 ? "persona" : "personas")}")</small>
                            <button type="button" class="team-chat-button" title="Abrir el chat de grupo de este equipo" disabled="@isMemberOperationInFlight" @onclick="AbrirChatDelEquipo"><span aria-hidden="true">💬</span> Chat del equipo</button>
                        </div>
                    </header>

                    <nav class="team-tabs" aria-label="Secciones del equipo">
                        <button type="button" class="team-tab @(activeTab == "members" ? "active" : "")" aria-current="@(activeTab == "members" ? "page" : null)" disabled="@isMemberOperationInFlight" @onclick='() => activeTab = "members"'><span aria-hidden="true">♧</span> Miembros @if (membersLoaded) { <span class="tab-count">@miembros.Count</span> }</button>
                        <button type="button" class="team-tab @(activeTab == "tasks" ? "active" : "")" aria-current="@(activeTab == "tasks" ? "page" : null)" disabled="@isMemberOperationInFlight" @onclick='() => activeTab = "tasks"'><span aria-hidden="true">▦</span> Tareas</button>
                    </nav>

                    @if (activeTab == "members")
                    {
                        <section class="members-section" aria-labelledby="members-title">
                            <div class="section-heading">
                                <div>
                                    <h3 id="members-title">Miembros del equipo</h3>
                                    <p>Personas que colaboran en este equipo.</p>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(memberRemoveError))
                            {
                                <p class="teams-alert teams-alert-error" role="alert">@memberRemoveError</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(memberRemoveFeedback))
                            {
                                <p class="teams-alert teams-alert-success" role="status">@memberRemoveFeedback</p>
                            }
                            @if (isLoadingMembers)
                            {
                                <p class="teams-status" role="status">Cargando miembros...</p>
                            }
                            else if (!string.IsNullOrWhiteSpace(membersError))
                            {
                                <div class="teams-load-error">
                                    <p class="members-empty" role="alert">@membersError</p>
                                    <button type="button" class="primary-button" @onclick="() => CargarMiembrosAsync(EquipoSeleccionado.Id, ++selectionRequestId)">Reintentar</button>
                                </div>
                            }
                            else if (miembros.Count == 0)
                            {
                                <p class="members-empty">No se encontraron miembros para este equipo.</p>
                            }
                            else
                            {
                                <ul class="member-list">
                                    @foreach (var member in miembros)
                                    {
                                        <li class="member-row">
                                            <span class="member-avatar" aria-hidden="true">@Iniciales(NombreMiembro(member))</span>
                                            <span class="member-copy"><span class="member-name">@NombreMiembro(member)</span><span class="member-email">@member.Email</span></span>
                                            @if (member.Id == EquipoSeleccionado.CreatedBy)
                                            {
                                                <span class="creator-badge">Creador</span>
                                            }
                                            @if (esJefeDelEquipo && member.Id != EquipoSeleccionado.CreatedBy)
                                            {
                                                <button type="button" class="member-remove-button @(pendingDeleteMemberId == member.Id ? "confirm-remove" : "")"
                                                        aria-label="@(pendingDeleteMemberId == member.Id ? $"Confirmar quitar a {NombreMiembro(member)} del equipo" : $"Quitar a {NombreMiembro(member)} del equipo")"
                                                        title="@(pendingDeleteMemberId == member.Id ? "Pulsa para confirmar" : "Quitar del equipo")"
                                                        disabled="@isMemberOperationInFlight"
                                                        @onclick="() => SolicitarQuitarMiembroAsync(member)">@(pendingDeleteMemberId == member.Id ? "¿Quitar?" : "✕")</button>
                                            }
                                        </li>
                                    }
                                </ul>
                            }

                            @if (puedeInvitarAlEquipo)
                            {
                                <section class="member-management" aria-labelledby="invite-member-title">
                                    <div class="section-heading">
                                        <h3 id="invite-member-title">Agregar miembro</h3>
                                        <p>Invita a una cuenta existente con su correo electrónico.</p>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(memberInviteError))
                                    {
                                        <p class="teams-alert teams-alert-error" role="alert">@memberInviteError</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(memberInviteFeedback))
                                    {
                                        <p class="teams-alert teams-alert-success" role="status">@memberInviteFeedback</p>
                                    }
                                    <form class="member-invite-form" @onsubmit="AgregarMiembroAsync" @onsubmit:preventDefault>
                                        <div class="form-field">
                                            <label for="member-email">Correo electrónico</label>
                                            <input id="member-email" type="email" @bind="memberEmail" required disabled="@isMemberInviteInFlight" />
                                        </div>
                                        <button type="submit" class="primary-button" disabled="@isMemberInviteInFlight">@(isMemberInviteInFlight ? "Agregando..." : "Agregar miembro")</button>
                                    </form>
                                </section>
                            }
                            else if (isLoadingTeams || teamsError is not null || !EsMiembroDelEquipoSeleccionado)
                            {
                                <p class="teams-status" role="status">No se muestran las opciones para invitar hasta confirmar que perteneces al equipo.</p>
                            }
                            else if (!esJefeDelEquipo)
                            {
                                <p class="teams-status" role="status">Solo la persona que creó el equipo puede agregar o quitar miembros.</p>
                            }
                            else if (isLoadingCurrentUserRole)
                            {
                                <p class="teams-status" role="status">Verificando tu rol para mostrar las opciones de invitación...</p>
                            }
                            else if (!string.IsNullOrWhiteSpace(currentUserRoleError))
                            {
                                <div class="teams-load-error">
                                    <p class="teams-status" role="alert">@currentUserRoleError</p>
                                    <button type="button" class="primary-button" @onclick="ReintentarVerificacionDeRolAsync">Reintentar</button>
                                </div>
                            }
                            else if (string.IsNullOrWhiteSpace(currentUserRole))
                            {
                                <p class="teams-status" role="status">No se pudo determinar tu rol. No se muestran las opciones para invitar.</p>
                            }
                            else
                            {
                                <p class="teams-status" role="status">Invitar está disponible para miembros del equipo con rol team_manager, project_manager o admin.</p>
                            }
                        </section>
                    }
                    else
                    {
                        <section class="tasks-section" aria-labelledby="tasks-title">
                            <header class="tasks-heading">
                                <div>
                                    <h3 id="tasks-title">Tareas del equipo</h3>
                                    @if (!isLoadingTasks && tasksError is null)
                                    {
                                        <p>@tareas.Count @(tareas.Count == 1 ? "tarea" : "tareas") · @(esJefeDelEquipo ? "Como creador gestionas todas: crear, editar, eliminar y cambiar estados." : "Solo lectura: cambia el estado de las tareas que están asignadas a ti.")</p>
                                    }
                                </div>
                                @if (esJefeDelEquipo && !isTaskFormOpen && tasksError is null)
                                {
                                    <span class="teams-count">@miembros.Count @(miembros.Count == 1 ? "persona" : "personas")</span>
                                }
                            </header>
                        </section>

                        @if (isTaskFormOpen)
                        {
                            <form class="task-form" @onsubmit="GuardarTareaAsync" @onsubmit:preventDefault>
                                <header class="task-form-heading">
                                    <div>
                                        <h4>@(editingTaskId is null ? "Crear tarea" : "Editar tarea")</h4>
                                        <p>Añade una tarea al equipo. Solo el título es obligatorio.</p>
                                    </div>
                                    <button type="button" class="text-button" disabled="@isTaskOperationInFlight" @onclick="CerrarFormulario">← Volver a tareas</button>
                                </header>
                                @if (isLoadingMembers)
                                {
                                    <p class="teams-status" role="status">Cargando miembros. El formulario estará disponible cuando termine la carga.</p>
                                }
                                else if (membersError is not null)
                                {
                                    <div class="members-load-form-error">
                                        <p class="members-empty" role="alert">No se pueden editar ni guardar tareas hasta cargar los miembros del equipo. @membersError</p>
                                        <button type="button" class="primary-button" disabled="@isTaskOperationInFlight" @onclick="() => CargarMiembrosAsync(EquipoSeleccionado.Id, ++selectionRequestId)">Reintentar carga de miembros</button>
                                    </div>
                                }
                                <div class="task-form-summary">
                                    <span><small>Equipo asociado</small><strong>⌑ @EquipoSeleccionado.Name</strong></span>
                                    <span><small>Estado @(editingTaskId is null ? "inicial" : "actual")</small><strong>@EtiquetaEstado(estadoEdicion)</strong></span>
                                </div>
                                <fieldset class="task-form-fields" disabled="@(!membersLoaded || isTaskOperationInFlight)">
                                    <div class="form-field">
                                        <label for="task-title">Título <span class="required-mark">*</span></label>
                                        <input id="task-title" type="text" maxlength="160" @bind="tituloTarea" required />
                                    </div>
                                    <div class="form-field">
                                        <label for="task-description">Descripción <span class="optional-label">(opcional)</span></label>
                                        <textarea id="task-description" rows="4" maxlength="2000" @bind="descripcionTarea"></textarea>
                                    </div>
                                    <div class="form-field">
                                        <label>Asignados <span class="optional-label">(opcional)</span></label>
                                        <div class="assignee-chips" role="group" aria-label="Personas asignadas a la tarea">
                                            @foreach (var member in miembros)
                                            {
                                                var asignado = asignadosTarea.Contains(member.Id);
                                                <label class="assignee-chip @(asignado ? "selected" : "")" title="@member.Email">
                                                    <input type="checkbox" checked="@asignado" @onchange="args => AlternarAsignado(member.Id)" />
                                                    <span class="chip-avatar" aria-hidden="true">@Iniciales(NombreMiembro(member))</span>
                                                    <span class="chip-copy"><span class="chip-name">@NombreMiembro(member)</span><span class="chip-email">@member.Email</span></span>
                                                </label>
                                            }
                                        </div>
                                        <small class="field-help">Marca a una o varias personas del equipo. El responsable principal es la primera persona marcada siguiendo el orden de la lista de miembros; si editas la tarea y el responsable actual sigue marcado, se conserva. Si la asignación actual ya no pertenece al equipo, al abrir la edición o al guardar se deja de asignar.</small>
                                    </div>
                                    <div class="form-field">
                                        <label for="task-due-date">Fecha límite <span class="optional-label">(opcional)</span></label>
                                        <input id="task-due-date" type="date" value="@fechaLimiteTarea" @onchange="ActualizarFechaLimite" />
                                        <small class="field-help">Puedes dejarla vacía si no hay fecha definida.</small>
                                    </div>
                                </fieldset>
                                <footer class="task-form-footer">
                                    <span><span class="required-mark">*</span> Campo obligatorio</span>
                                    <div>
                                        <button type="button" class="secondary-button" disabled="@isTaskOperationInFlight" @onclick="CerrarFormulario">Cancelar</button>
                                        <button type="submit" class="primary-button" disabled="@(!membersLoaded || isTaskOperationInFlight || string.IsNullOrWhiteSpace(tituloTarea))">@(isTaskOperationInFlight ? "Guardando..." : editingTaskId is null ? "Crear tarea" : "Guardar cambios")</button>
                                    </div>
                                </footer>
                            </form>
                        }
                        else if (isLoadingTasks)
                        {
                            <p class="teams-status" role="status">Cargando tareas...</p>
                        }
                        else if (!string.IsNullOrWhiteSpace(tasksError))
                        {
                            <div class="teams-load-error">
                                <p class="teams-status" role="alert">@tasksError</p>
                                <button type="button" class="primary-button" @onclick="() => CargarTareasAsync(EquipoSeleccionado.Id, ++selectionRequestId)">Reintentar</button>
                            </div>
                        }
                        else
                        {
                            <div class="kanban-board">
                                @foreach (var column in KanbanColumns)
                                {
                                    var columnTasks = tareas.Where(task => task.Status == column.Status).ToList();
                                    <section class="kanban-column @column.CssClass" aria-label="@column.Title">
                                        <header class="kanban-column-heading">
                                            <div><span class="status-dot"></span><h4>@column.Title</h4></div>
                                            <span class="column-count">@columnTasks.Count</span>
                                        </header>
                                        <small class="status-key">@column.Status</small>
                                        <div class="kanban-cards">
                                            @if (columnTasks.Count == 0)
                                            {
                                                <p class="column-empty">No hay tareas</p>
                                            }
                                            @foreach (var task in columnTasks)
                                            {
                                                var assignedLabels = EtiquetasAsignados(task);
                                                <TaskCard Task="task" Assignees="assignedLabels" IsDeleting="@(pendingDeleteId == task.Id)" IsBusy="@(isTaskOperationInFlight || !membersLoaded)" CanEdit="esJefeDelEquipo" CanDelete="esJefeDelEquipo" CanChangeStatus="PuedeCambiarEstado(task)" OnStatusChanged="(status) => CambiarEstadoAsync(task, status)" OnEdit="() => EditarTarea(task)" OnDelete="() => SolicitarEliminarAsync(task)" />
                                            }
                                        </div>
                                    </section>
                                }
                            </div>
                            <p class="task-board-notice">@(esJefeDelEquipo ? "ⓘ Usa el lápiz para editar o la papelera para eliminar. Cambia el estado desde cada tarea." : "ⓘ Solo el creador puede crear, editar o eliminar tareas. Puedes cambiar el estado de las que están asignadas a ti.")</p>
                        }
                    }
                }
            </section>
        </div>
    }
</section>

@code {
    private List<Team> equipos = [];
    private List<Profile> miembros = [];
    private List<TeamTask> tareas = [];
    private Guid? selectedTeamId;
    private Guid? currentUserId;
    private string? currentUserRole;
    private string activeTab = "members";
    private string? teamsError;
    private string? membersError;
    private string? tasksError;
    private string? pageError;
    private string? feedback;
    private string memberEmail = "";
    private string? memberInviteError;
    private string? memberInviteFeedback;
    private Guid? pendingDeleteMemberId;
    private string? memberRemoveError;
    private string? memberRemoveFeedback;
    private bool isMemberRemoveInFlight;
    private bool isLoadingTeams = true;
    private bool isLoadingCurrentUserRole = true;
    private bool isLoadingMembers;
    private bool membersLoaded;
    private bool isLoadingTasks;
    private bool isTaskFormOpen;
    private bool isTaskOperationInFlight;
    private bool isMemberInviteInFlight;
    private bool puedeInvitarAlEquipo;
    private string? currentUserRoleError;
    private Guid? editingTaskId;
    private Guid? pendingDeleteId;
    private readonly HashSet<Guid> asignadosTarea = [];
    private Dictionary<Guid, List<Guid>> asignadosPorTarea = [];
    private string tituloTarea = "";
    private string descripcionTarea = "";
    private string fechaLimiteTarea = "";
    private string estadoEdicion = "todo";
    private int selectionRequestId;
    private string nombreNuevoEquipo = string.Empty;
    private string descripcionNuevoEquipo = string.Empty;
    private readonly HashSet<Guid> addingMemberTeamIds = [];
    private string? teamCreationPermissionError;
    private bool isCreatingTeam;
    private bool isCheckingTeamCreationPermission = true;
    private bool canCreateTeam;
    private string? errorMessage;
    private string? memberValidationMessage;
    private string? feedbackMessage;
    private string? pendingTeamCreationConfirmation;

    private static readonly List<(string Title, string Status, string CssClass)> KanbanColumns = new()
    {
        ("Por hacer", "todo", "kanban-todo"),
        ("En curso", "in_progress", "kanban-in-progress"),
        ("Hechas", "done", "kanban-done")
    };

    private Team? EquipoSeleccionado =>
        equipos.FirstOrDefault(team => team.Id == selectedTeamId);

    private bool EsMiembroDelEquipoSeleccionado =>
        EquipoSeleccionado is { } team &&
        !isLoadingTeams &&
        teamsError is null &&
        equipos.Any(equipo => equipo.Id == team.Id);

    private bool esJefeDelEquipo =>
        EquipoSeleccionado is { } equipo && currentUserId is Guid usuario && equipo.CreatedBy == usuario;

    private bool isMemberOperationInFlight => isMemberInviteInFlight || isMemberRemoveInFlight;

    private async Task VerificarPermisoInvitacionAsync()
    {
        puedeInvitarAlEquipo = false;
        if (EquipoSeleccionado is not { } team) return;
        try
        {
            puedeInvitarAlEquipo = await SupabaseService.PuedeInvitarAlEquipoAsync(team.Id);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "No se pudo comprobar el permiso de invitación del equipo {TeamId}.", team.Id);
            currentUserRoleError = "No se pudieron verificar tus permisos. Las opciones para invitar permanecerán ocultas.";
        }
    }

    private async Task ReintentarVerificacionDeRolAsync()
    {
        await CargarRolUsuarioAsync();
        await VerificarPermisoInvitacionAsync();
    }

    private async Task CargarRolUsuarioAsync()
    {
        isLoadingCurrentUserRole = true;
        currentUserRoleError = null;
        try
        {
            currentUserRole = await SupabaseService.ObtenerRolUsuarioActualAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "No se pudo consultar el rol del usuario actual.");
            currentUserRoleError = "No se pudo consultar tu rol.";
        }
        finally
        {
            isLoadingCurrentUserRole = false;
        }
    }

    private bool PuedeCambiarEstado(TeamTask task) =>
        esJefeDelEquipo || (currentUserId is Guid usuario && task.AssigneeId == usuario);

    protected override async Task OnInitializedAsync()
    {
        await CargarPermisosCrearEquipoAsync();
        await CargarEquiposAsync();
    }

    private async Task CargarPermisosCrearEquipoAsync()
    {
        isCheckingTeamCreationPermission = true;
        teamCreationPermissionError = null;
        canCreateTeam = false;
        try
        {
            canCreateTeam = await SupabaseService.PuedeCrearEquipoAsync();
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "No hay una sesión válida para consultar los permisos de creación de equipos.");
            Navigation.NavigateTo("/login");
            teamCreationPermissionError = "Se requiere una sesión válida para verificar los permisos.";
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudieron consultar los permisos de creación de equipos.");
            teamCreationPermissionError = "No se pudieron verificar tus permisos. No es posible crear equipos en este momento.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase devolvió un error al consultar los permisos de creación de equipos.");
            teamCreationPermissionError = "No se pudieron verificar tus permisos. No es posible crear equipos en este momento.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ocurrió un error inesperado al consultar los permisos de creación de equipos.");
            teamCreationPermissionError = "No se pudieron verificar tus permisos. No es posible crear equipos en este momento.";
        }
        finally
        {
            isCheckingTeamCreationPermission = false;
        }
    }

    private async Task CargarEquiposAsync()
    {
        isLoadingTeams = true;
        teamsError = null;
        try
        {
            await SupabaseService.Initialization;
            if (!Guid.TryParse(SupabaseService.Client.Auth.CurrentSession?.User?.Id, out var userId))
            {
                throw new InvalidOperationException("Se requiere una sesión autenticada para consultar los equipos.");
            }

            currentUserId = userId;
            equipos = await SupabaseService.ObtenerEquiposDelUsuario();
            pendingTeamCreationConfirmation = null;

            if (equipos.Count > 0)
            {
                await SeleccionarEquipoAsync(equipos[0].Id);
            }
            else
            {
                selectedTeamId = null;
                miembros = [];
                membersLoaded = false;
                tareas = [];
                puedeInvitarAlEquipo = false;
            }
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "No hay una sesión válida para consultar los equipos.");
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudieron cargar los equipos desde Supabase.");
            teamsError = "No se pudieron cargar tus equipos. Comprueba tu conexión e inténtalo de nuevo.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase devolvió un error al consultar los equipos.");
            teamsError = "Ocurrió un error al consultar tus equipos.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ocurrió un error inesperado al cargar los equipos.");
            teamsError = "No se pudieron cargar tus equipos. Inténtalo de nuevo más tarde.";
        }
        finally
        {
            isLoadingTeams = false;
        }
    }

    private async Task SeleccionarEquipoAsync(Guid teamId)
    {
        if (isTaskOperationInFlight || isMemberOperationInFlight) return;
        if (selectedTeamId != teamId)
        {
            errorMessage = null;
            feedbackMessage = null;
        }

        selectedTeamId = teamId;
        activeTab = "members";
        feedback = null;
        pageError = null;
        memberInviteError = null;
        memberInviteFeedback = null;
        memberRemoveError = null;
        memberRemoveFeedback = null;
        pendingDeleteMemberId = null;
        memberEmail = "";
        isTaskFormOpen = false;
        pendingDeleteId = null;
        asignadosTarea.Clear();
        asignadosPorTarea = [];
        puedeInvitarAlEquipo = false;
        var requestId = ++selectionRequestId;
        miembros = [];
        membersLoaded = false;
        tareas = [];
        isLoadingMembers = true;
        isLoadingTasks = true;
        membersError = null;
        tasksError = null;
        await Task.WhenAll(
            CargarMiembrosAsync(teamId, requestId),
            CargarTareasAsync(teamId, requestId),
            VerificarPermisoInvitacionAsync());
    }

    private async Task CargarMiembrosAsync(Guid teamId, int requestId)
    {
        try
        {
            var resultado = await SupabaseService.ObtenerMiembrosDelEquipo(teamId);
            if (requestId == selectionRequestId && selectedTeamId == teamId)
            {
                miembros = resultado;
                membersLoaded = true;
            }
        }
        catch (InvalidOperationException exception)
        {
            if (requestId == selectionRequestId && selectedTeamId == teamId)
            {
                Logger.LogWarning(exception, "No hay una sesión válida para consultar los miembros del equipo {TeamId}.", teamId);
                Navigation.NavigateTo("/login");
                membersError = "Se requiere una sesión válida para consultar los miembros.";
            }
        }
        catch (HttpRequestException exception)
        {
            if (requestId == selectionRequestId && selectedTeamId == teamId)
            {
                Logger.LogError(exception, "No se pudieron cargar los miembros del equipo {TeamId}.", teamId);
                membersError = "No se pudieron cargar los miembros. Inténtalo de nuevo.";
            }
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            if (requestId == selectionRequestId && selectedTeamId == teamId)
            {
                Logger.LogError(exception, "Supabase devolvió un error al consultar los miembros del equipo {TeamId}.", teamId);
                membersError = "Ocurrió un error al consultar los miembros de este equipo.";
            }
        }
        catch (Exception exception)
        {
            if (requestId == selectionRequestId && selectedTeamId == teamId)
            {
                Logger.LogError(exception, "Ocurrió un error inesperado al cargar los miembros del equipo {TeamId}.", teamId);
                membersError = "No se pudieron cargar los miembros. Inténtalo de nuevo más tarde.";
            }
        }
        finally
        {
            if (requestId == selectionRequestId && selectedTeamId == teamId)
            {
                isLoadingMembers = false;
            }
        }
    }

    private async Task ReintentarCargarMiembrosAsync()
    {
        if (selectedTeamId is Guid teamId)
        {
            await CargarMiembrosAsync(teamId, ++selectionRequestId);
        }
    }

    private async Task CargarTareasAsync(Guid teamId, int requestId)
    {
        try
        {
            var result = await SupabaseService.ObtenerTareas(teamId);
            var asignados = await SupabaseService.ObtenerAsignadosAsync(result.Select(task => task.Id));
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                tareas = result;
                asignadosPorTarea = asignados;
            }
        }
        catch (Exception exception)
        {
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                Logger.LogError(exception, "No se pudieron cargar las tareas del equipo {TeamId}.", teamId);
                tasksError = "No se pudieron cargar las tareas. Inténtalo de nuevo más tarde.";
            }
        }
        finally
        {
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                isLoadingTasks = false;
            }
        }
