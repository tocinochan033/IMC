    private IEnumerable<Guid> ObtenerAsignadosDe(TeamTask task)
    {
        if (asignadosPorTarea.TryGetValue(task.Id, out var guardados)) return guardados;
        if (task.AssigneeId is Guid principal) return [principal];
        return [];
    }

    private List<string> EtiquetasAsignados(TeamTask task)
    {
        List<string> etiquetas = [];
        foreach (var assignedId in ObtenerAsignadosDe(task).OrderBy(id => id == task.AssigneeId ? 0 : 1))
        {
            var member = miembros.FirstOrDefault(item => item.Id == assignedId);
            etiquetas.Add(member is null ? "Perfil asignado no disponible" : NombreMiembro(member));
        }
        return etiquetas;
    }

    private async Task SolicitarQuitarMiembroAsync(Profile member)
    {
        if (isMemberOperationInFlight || !esJefeDelEquipo || EquipoSeleccionado is not { } team) return;
        pageError = null;
        memberRemoveError = null;
        if (pendingDeleteMemberId == member.Id)
        {
            await QuitarMiembroAsync(team, member);
        }
        else
        {
            pendingDeleteMemberId = member.Id;
        }
    }

    private async Task QuitarMiembroAsync(Team team, Profile member)
    {
        var teamId = team.Id;
        var requestId = selectionRequestId;
        isMemberRemoveInFlight = true;
        memberRemoveError = null;
        memberRemoveFeedback = null;
        try
        {
            var result = await SupabaseService.EliminarMiembro(teamId, member.Id);
            if (selectedTeamId != teamId || selectionRequestId != requestId) return;
            switch (result)
            {
                case ResultadoEliminarMiembro.Eliminado:
                    memberRemoveFeedback = $"Se quitó a {NombreMiembro(member)} del equipo.";
                    await Task.WhenAll(CargarMiembrosAsync(teamId, requestId), CargarTareasAsync(teamId, requestId));
                    break;
                case ResultadoEliminarMiembro.NoAutorizado:
                    memberRemoveError = "Solo la persona que creó el equipo puede quitar miembros.";
                    break;
                case ResultadoEliminarMiembro.NoEsMiembro:
                    memberRemoveError = "Esa persona ya no pertenece al equipo.";
                    await CargarMiembrosAsync(teamId, requestId);
                    break;
                case ResultadoEliminarMiembro.NoEliminarJefe:
                    memberRemoveError = "El equipo no puede quedarse sin persona creadora: no puedes quitarte a ti mismo.";
                    break;
            }
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogWarning(exception, "Supabase rechazó quitar a {MemberId} del equipo {TeamId}.", member.Id, teamId);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                memberRemoveError = "Supabase rechazó la solicitud. Puede deberse a la política RLS; verifica los permisos del equipo y vuelve a intentarlo.";
            }
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "Se requiere una sesión válida para quitar miembros del equipo {TeamId}.", teamId);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                memberRemoveError = "Tu sesión ha expirado. Vuelve a entrar para continuar.";
            }
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo conectar con Supabase para quitar un miembro del equipo {TeamId}.", teamId);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                memberRemoveError = "Sin conexión con el servidor. Inténtalo de nuevo.";
            }
        }
        catch (OperationCanceledException exception)
        {
            Logger.LogWarning(exception, "Se superó el tiempo de espera al quitar un miembro del equipo {TeamId}.", teamId);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                memberRemoveError = "Se superó el tiempo de espera. Inténtalo de nuevo.";
            }
        }
        catch (System.Text.Json.JsonException exception)
        {
            Logger.LogWarning(exception, "Respuesta inesperada de Supabase al quitar un miembro del equipo {TeamId}.", teamId);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                memberRemoveError = "Respuesta inesperada del servidor. Inténtalo de nuevo.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "No se pudo quitar a {MemberId} del equipo {TeamId}.", member.Id, teamId);
            if (selectedTeamId == teamId && selectionRequestId == requestId)
            {
                memberRemoveError = "No se pudo quitar al miembro. Comprueba tus permisos e inténtalo de nuevo.";
            }
        }
        finally
        {
            pendingDeleteMemberId = null;
            isMemberRemoveInFlight = false;
        }
    }

