@page "/destacados"
@using IMC_.Models
@using IMC_.Services
@inject SupabaseService SupabaseService
@inject NavigationManager Navigation
@inject ILogger<Destacados> Logger

<PageTitle>Destacados</PageTitle>

<MailboxFolderView Title="Destacados"
                   EmptyText="No hay mensajes destacados."
                   SearchInputId="buscar-destacados"
                   Messages="@mensajes"
                   IsLoading="@isLoading"
                   ErrorMessage="@errorMessage"
                   SearchTerm="@terminoBusqueda"
                   SearchTermChanged="@BuscarMensajes"
                   ShowStar="true"
                   OnToggleStar="@QuitarDestacado" />

@code {
    private List<(MailboxEntry Entry, Message Message)> mensajes = [];
    private bool isLoading = true;
    private string terminoBusqueda = string.Empty;
    private string? errorMessage;
    private int searchRequestId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await SupabaseService.Initialization;
            var userId = SupabaseService.Client.Auth.CurrentSession?.User?.Id;
            if (!Guid.TryParse(userId, out var authenticatedUserId))
            {
                throw new InvalidOperationException("Se requiere una sesión autenticada para consultar los destacados.");
            }

            mensajes = await SupabaseService.ObtenerDestacados(authenticatedUserId);
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "No hay una sesión válida para consultar los destacados.");
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudieron cargar los mensajes destacados desde Supabase.");
            errorMessage = "No se pudieron cargar los mensajes destacados. Inténtalo de nuevo.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase devolvió un error al consultar los destacados.");
            errorMessage = "Ocurrió un error al consultar los mensajes destacados.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task BuscarMensajes(string termino)
    {
        terminoBusqueda = termino;
        var requestId = ++searchRequestId;
        errorMessage = null;

        try
        {
            await SupabaseService.Initialization;
            if (!Guid.TryParse(SupabaseService.Client.Auth.CurrentSession?.User?.Id, out var userId))
            {
                throw new InvalidOperationException("Se requiere una sesión autenticada para buscar mensajes.");
            }

            var resultados = string.IsNullOrWhiteSpace(termino)
                ? await SupabaseService.ObtenerDestacados(userId)
                : await SupabaseService.BuscarMensajes(userId, termino, "starred");

            if (requestId == searchRequestId)
            {
                mensajes = resultados;
            }
        }
        catch (InvalidOperationException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogWarning(exception, "No hay una sesión válida para buscar en los destacados.");
                Navigation.NavigateTo("/login");
            }
        }
        catch (HttpRequestException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogError(exception, "No se pudieron buscar mensajes destacados desde Supabase.");
                errorMessage = "No se pudieron buscar los mensajes destacados. Inténtalo de nuevo.";
            }
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogError(exception, "Supabase devolvió un error al buscar en los destacados.");
                errorMessage = "Ocurrió un error al buscar en los mensajes destacados.";
            }
        }
    }

    private async Task QuitarDestacado(MailboxEntry entry)
    {
        errorMessage = null;
        try
        {
            await SupabaseService.ToggleDestacado(entry.Id, false);
            entry.IsStarred = false;
            mensajes.RemoveAll(item => item.Entry.Id == entry.Id);
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "No hay una sesión válida para actualizar el destacado.");
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo quitar de destacados la entrada {MailboxEntryId}.", entry.Id);
            errorMessage = "No se pudo actualizar el mensaje destacado. Inténtalo de nuevo.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase rechazó actualizar la entrada {MailboxEntryId}.", entry.Id);
            errorMessage = "No se pudo actualizar el mensaje destacado. Inténtalo de nuevo.";
        }
    }
}
