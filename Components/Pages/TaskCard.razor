@using IMC_.Models

<article class="task-card">
    <h5>@Task.Title</h5>
    @if (!string.IsNullOrWhiteSpace(Task.Description))
    {
        <p class="task-description">@Task.Description</p>
    }
    <div class="task-card-meta">
        @if (Assignees.Count == 0)
        {
            <span class="task-assignee unassigned"><span class="person-symbol" aria-hidden="true">♙</span> Sin asignar</span>
        }
        else
        {
            @* Asignación múltiple: una fila por asignado. El contenedor tiene scroll para que
               una tarea con muchos responsables no desborde la tarjeta del kanban. *@
            <ul class="task-assignees" aria-label="Asignados">
                @foreach (var assignee in Assignees)
                {
                    <li class="task-assignee" title="@assignee">
                        <span class="small-avatar" aria-hidden="true">@Initials(assignee)</span>
                        <span class="assignee-email">@assignee</span>
                    </li>
                }
            </ul>
        }
        @if (Task.DueAt is DateTimeOffset dueAt)
        {
            <span class="task-due"><span aria-hidden="true">▦</span> @dueAt.ToLocalTime().ToString("dd MMM yyyy")</span>
        }
        else
        {
            <span class="task-due"><span aria-hidden="true">▦</span> Sin fecha límite</span>
        }
    </div>
    <footer class="task-card-actions">
        @if (CanChangeStatus)
        {
            <select class="status-select @StatusCss" aria-label="@($"Cambiar estado de {Task.Title}")"
                    value="@Task.Status" disabled="@IsBusy" @onchange="StatusChanged">
                <option value="todo">Por hacer</option>
                <option value="in_progress">En curso</option>
                <option value="done">Hechas</option>
            </select>
        }
        else
        {
            @* Sin permiso se pinta el estado como texto: un <select> deshabilitado sugiere que
               la tarea es editable cuando no lo es para esta persona. *@
            <span class="status-readonly @StatusCss" title="@StatusReadOnlyTitle">@StatusLabel(Task.Status)</span>
        }
        @if (CanEdit || CanDelete)
        {
            <div class="task-actions">
                @if (CanEdit)
                {
                    <button type="button" class="icon-button edit-action" aria-label="@($"Editar {Task.Title}")"
                            title="Editar tarea" disabled="@IsBusy" @onclick="OnEdit">✎</button>
                }
                @if (CanDelete)
                {
                    <button type="button" class="icon-button delete-action @(IsDeleting ? "confirm-delete" : "")"
                            aria-label="@(IsDeleting ? "Confirmar eliminación" : $"Eliminar {Task.Title}")"
                            title="@(IsDeleting ? "Pulsa para confirmar" : "Eliminar tarea")" disabled="@IsBusy" @onclick="OnDelete">
                        @(IsDeleting ? "¿Eliminar?" : "▤")
                    </button>
                }
            </div>
        }
    </footer>
</article>

@code {
    [Parameter, EditorRequired] public TeamTask Task { get; set; } = null!;
    // Etiquetas ya resueltas (nombre o email) de TODOS los asignados de la tarea; la página
    // hace la traducción id → perfil porque es quien tiene cargados los miembros del equipo.
    [Parameter] public IReadOnlyList<string> Assignees { get; set; } = Array.Empty<string>();
    // Permisos calculados por la página: solo el creador del equipo edita/elimina; el estado
    // lo cambia el creador o quien tiene la tarea como asignado principal (lo que permite la BD).
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool CanChangeStatus { get; set; }
    [Parameter] public bool IsDeleting { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback<string> OnStatusChanged { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private const string StatusReadOnlyTitle = "Solo el creador del equipo o la persona asignada pueden cambiar el estado.";

    private string StatusCss => Task.Status switch
    {
        "in_progress" => "status-in-progress",
        "done" => "status-done",
        _ => "status-todo"
    };

    private Task StatusChanged(ChangeEventArgs args) =>
        OnStatusChanged.InvokeAsync(args.Value?.ToString() ?? Task.Status);

    private static string StatusLabel(string status) => status switch
    {
        "in_progress" => "En curso",
        "done" => "Hechas",
        _ => "Por hacer"
    };

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1
            ? string.Concat(char.ToUpperInvariant(parts[0][0]), char.ToUpperInvariant(parts[^1][0]))
            : name[..1].ToUpperInvariant();
    }
}
