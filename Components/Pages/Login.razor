@page "/login"
@page "/"
@layout LoginLayout
@using Supabase.Gotrue.Exceptions
@inject SupabaseService SupabaseService
@inject NavigationManager Navigation
@inject ILogger<Login> Logger

<PageTitle>Iniciar sesión</PageTitle>

<div class="login-page">
    <header class="login-header">
        <a class="brand" href="/" aria-label="Micelio">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <rect x="3.5" y="5.5" width="17" height="13" rx="1.5" />
                    <path d="m4.5 7 7.5 5.5L19.5 7" />
                </svg>
            </span>
            <span class="brand-name">Micelio</span>
        </a>
    </header>

    <main class="login-main">
        <section class="login-card" aria-labelledby="login-title">
            <div class="login-card-header">
                <h1 id="login-title">Iniciar sesión</h1>
            </div>

            <form class="login-form" @onsubmit="HandleLogin" @onsubmit:preventDefault>
                <div class="form-field">
                    <label for="email">Correo</label>
                    <div class="input-with-icon">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M15.5 15.5v-4a3.5 3.5 0 1 0-1 2.5c.5 1 2 1.5 3 0" />
                        </svg>
                        <input id="email" type="email" class="form-control" placeholder="correo@ejemplo.edu"
                               autocomplete="username" @bind="Email" required />
                    </div>
                </div>

                <div class="form-field">
                    <label for="password">Contraseña</label>
                    <div class="input-with-icon">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <rect x="4" y="10" width="16" height="11" rx="2" />
                            <path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2" />
                        </svg>
                        <input id="password" type="password" class="form-control" placeholder="Contraseña"
                               autocomplete="current-password" @bind="Password" required />
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <p class="login-error" role="alert">@ErrorMessage</p>
                }

                <button type="submit" class="login-submit" disabled="@isSigningIn">
                    @if (isSigningIn)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>Ingresando...</span>
                    }
                    else
                    {
                        <span>Entrar</span>
                    }
                </button>
            </form>
        </section>
    </main>
</div>

@code {
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }
    private bool isSigningIn;

    private async Task HandleLogin()
    {
        if (isSigningIn)
        {
            return;
        }

        isSigningIn = true;
        ErrorMessage = null;

        try
        {
            await SupabaseService.SignInAsync(Email, Password);
            Navigation.NavigateTo("/bandeja");
        }
        catch (GotrueException exception)
        {
            Logger.LogWarning(
                "Supabase rechazó el inicio de sesión. Estado: {StatusCode}, código: {ErrorCode}",
                exception.StatusCode,
                exception.ErrorCode);
            ErrorMessage = "No se pudo iniciar sesión. Verifica tu correo y contraseña.";
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo conectar con Supabase Auth.");
            ErrorMessage = "No se pudo conectar con el servicio de inicio de sesión. Inténtalo de nuevo.";
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogError(exception, "La configuración o respuesta de Supabase Auth no es válida.");
            ErrorMessage = "El servicio de inicio de sesión no está configurado correctamente.";
        }
        finally
        {
            isSigningIn = false;
        }
    }
}
