@page "/enviados"
@using IMC_.Models
@using IMC_.Services
@inject SupabaseService SupabaseService
@inject NavigationManager Navigation
@inject ILogger<Enviados> Logger

<PageTitle>Enviados</PageTitle>

<MailboxFolderView Title="Enviados"
                   EmptyText="No hay mensajes enviados."
                   SearchInputId="buscar-enviados"
                   Messages="@mensajes"
                   IsLoading="@isLoading"
                   ErrorMessage="@errorMessage"
                   SearchTerm="@terminoBusqueda"
                   SearchTermChanged="@BuscarMensajes"
                   ShowDelete="true"
                   OnMoveToTrash="@MoverAPapelera" />

@code {
    private List<(MailboxEntry Entry, Message Message)> mensajes = [];
    private bool isLoading = true;
    private string terminoBusqueda = string.Empty;
    private string? errorMessage;
    private int searchRequestId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            mensajes = await SupabaseService.ObtenerEnviadosAsync();
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "No hay una sesión válida para consultar los enviados.");
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudieron cargar los mensajes enviados desde Supabase.");
            errorMessage = "No se pudieron cargar los mensajes enviados. Inténtalo de nuevo.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase devolvió un error al consultar los enviados.");
            errorMessage = "Ocurrió un error al consultar los mensajes enviados.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task BuscarMensajes(string termino)
    {
        terminoBusqueda = termino;
        var requestId = ++searchRequestId;
        errorMessage = null;

        try
        {
            List<(MailboxEntry Entry, Message Message)> resultados;
            if (string.IsNullOrWhiteSpace(termino))
            {
                resultados = await SupabaseService.ObtenerEnviadosAsync();
            }
            else
            {
                await SupabaseService.Initialization;
                if (!Guid.TryParse(SupabaseService.Client.Auth.CurrentSession?.User?.Id, out var userId))
                {
                    throw new InvalidOperationException("Se requiere una sesión autenticada para buscar mensajes.");
                }

                resultados = await SupabaseService.BuscarMensajes(userId, termino, "sent");
            }

            if (requestId == searchRequestId)
            {
                mensajes = resultados;
            }
        }
        catch (InvalidOperationException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogWarning(exception, "No hay una sesión válida para buscar en los enviados.");
                Navigation.NavigateTo("/login");
            }
        }
        catch (HttpRequestException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogError(exception, "No se pudieron buscar mensajes enviados desde Supabase.");
                errorMessage = "No se pudieron buscar los mensajes enviados. Inténtalo de nuevo.";
            }
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogError(exception, "Supabase devolvió un error al buscar los enviados.");
                errorMessage = "Ocurrió un error al buscar en los mensajes enviados.";
            }
        }
    }

    private async Task MoverAPapelera(Guid mailboxEntryId)
    {
        errorMessage = null;
        try
        {
            await SupabaseService.MoverAPapelera(mailboxEntryId);
            mensajes.RemoveAll(item => item.Entry.Id == mailboxEntryId);
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "La sesión no es válida para mover la entrada {MailboxEntryId}.", mailboxEntryId);
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo mover la entrada {MailboxEntryId} a la papelera.", mailboxEntryId);
            errorMessage = "No se pudo mover el mensaje a la papelera. Inténtalo de nuevo.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase rechazó mover la entrada {MailboxEntryId} a la papelera.", mailboxEntryId);
            errorMessage = "No se pudo mover el mensaje a la papelera. Inténtalo de nuevo.";
        }
    }
}
