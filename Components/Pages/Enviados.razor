@page "/enviados"
@using IMC_.Models
@using IMC_.Services
@inject SupabaseService SupabaseService
@inject NavigationManager Navigation
@inject ILogger<Enviados> Logger

<PageTitle>Enviados</PageTitle>

<h1>Enviados</h1>

<div class="mb-3">
    <label for="buscar-enviados" class="form-label">Buscar por asunto o remitente</label>
    <input id="buscar-enviados" type="search" class="form-control" placeholder="Buscar mensajes..."
           value="@terminoBusqueda" @oninput="BuscarMensajes" />
</div>

@if (isLoading)
{
    <p>Cargando mensajes...</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="alert alert-danger" role="alert">@errorMessage</p>
    }

    @if (mensajes.Count == 0)
    {
        <p>No hay mensajes enviados.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var mensaje in mensajes)
            {
                <li class="list-group-item d-flex align-items-center p-0">
                    <button type="button"
                            class="btn btn-link text-start text-decoration-none text-reset flex-grow-1"
                            @onclick="() => AbrirMensaje(mensaje.Message.Id)">
                        <span class="d-block">Remitente: @mensaje.Message.SenderId</span>
                        <span class="d-block">@mensaje.Message.Subject</span>
                        <span class="d-block">@VistaPrevia(mensaje.Message.Body)</span>
                    </button>
                    <button type="button"
                            class="btn btn-outline-danger me-2"
                            aria-label="Mover a papelera"
                            title="Mover a papelera"
                            disabled="@movingEntryIds.Contains(mensaje.Entry.Id)"
                            @onclick="() => MoverAPapelera(mensaje.Entry.Id)">
                        Eliminar
                    </button>
                </li>
            }
        </ul>
    }
}

@code {
    private List<(MailboxEntry Entry, Message Message)> mensajes = [];
    private HashSet<Guid> movingEntryIds = [];
    private bool isLoading = true;
    private string terminoBusqueda = string.Empty;
    private string? errorMessage;
    private int searchRequestId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            mensajes = await SupabaseService.ObtenerEnviadosAsync();
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "No hay una sesión válida para consultar los enviados.");
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudieron cargar los mensajes enviados desde Supabase.");
            errorMessage = "No se pudieron cargar los mensajes enviados. Inténtalo de nuevo.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase devolvió un error al consultar los enviados.");
            errorMessage = "Ocurrió un error al consultar los mensajes enviados.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AbrirMensaje(Guid id)
    {
        Navigation.NavigateTo($"/mensaje/{id}");
    }

    private async Task BuscarMensajes(ChangeEventArgs args)
    {
        terminoBusqueda = args.Value?.ToString() ?? string.Empty;
        var requestId = ++searchRequestId;
        errorMessage = null;

        try
        {
            List<(MailboxEntry Entry, Message Message)> resultados;
            if (string.IsNullOrWhiteSpace(terminoBusqueda))
            {
                resultados = await SupabaseService.ObtenerEnviadosAsync();
            }
            else
            {
                await SupabaseService.Initialization;
                if (!Guid.TryParse(SupabaseService.Client.Auth.CurrentSession?.User?.Id, out var userId))
                {
                    throw new InvalidOperationException("Se requiere una sesión autenticada para buscar mensajes.");
                }

                resultados = await SupabaseService.BuscarMensajes(userId, terminoBusqueda, "sent");
            }

            if (requestId == searchRequestId)
            {
                mensajes = resultados;
            }
        }
        catch (InvalidOperationException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogWarning(exception, "No hay una sesión válida para buscar en los enviados.");
                Navigation.NavigateTo("/login");
            }
        }
        catch (HttpRequestException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogError(exception, "No se pudieron buscar mensajes enviados desde Supabase.");
                errorMessage = "No se pudieron buscar los mensajes enviados. Inténtalo de nuevo.";
            }
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogError(exception, "Supabase devolvió un error al buscar los enviados.");
                errorMessage = "Ocurrió un error al buscar en los mensajes enviados.";
            }
        }
    }

    private async Task MoverAPapelera(Guid mailboxEntryId)
    {
        if (!movingEntryIds.Add(mailboxEntryId))
        {
            return;
        }

        errorMessage = null;
        try
        {
            await SupabaseService.MoverAPapelera(mailboxEntryId);
            mensajes.RemoveAll(mensaje => mensaje.Entry.Id == mailboxEntryId);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo mover la entrada {MailboxEntryId} a la papelera.", mailboxEntryId);
            errorMessage = "No se pudo mover el mensaje a la papelera. Inténtalo de nuevo.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase rechazó mover la entrada {MailboxEntryId} a la papelera.", mailboxEntryId);
            errorMessage = "No se pudo mover el mensaje a la papelera. Inténtalo de nuevo.";
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "La sesión no es válida para mover la entrada {MailboxEntryId}.", mailboxEntryId);
            Navigation.NavigateTo("/login");
        }
        finally
        {
            movingEntryIds.Remove(mailboxEntryId);
        }
    }

    private static string VistaPrevia(string cuerpo)
    {
        const int longitudMaxima = 120;
        return cuerpo.Length <= longitudMaxima
            ? cuerpo
            : $"{cuerpo[..longitudMaxima]}…";
    }
}
