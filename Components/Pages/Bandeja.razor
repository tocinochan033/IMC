@page "/bandeja"
@using IMC_.Models
@using IMC_.Services
@inject SupabaseService SupabaseService
@inject NavigationManager Navigation
@inject ILogger<Bandeja> Logger

<PageTitle>@(string.IsNullOrWhiteSpace(EtiquetaSeleccionada) ? "Bandeja de entrada" : EtiquetaSeleccionada)</PageTitle>

<section class="inbox-page" aria-labelledby="inbox-title">
    <header class="inbox-header">
        <h1 id="inbox-title">@(string.IsNullOrWhiteSpace(EtiquetaSeleccionada) ? "Bandeja de entrada" : $"Etiqueta: {EtiquetaSeleccionada}")</h1>
        <label class="inbox-search" for="buscar-bandeja">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="m16 16 4 4" />
            </svg>
            <span class="visually-hidden">Buscar por asunto o remitente</span>
            <input id="buscar-bandeja" type="search" placeholder="Buscar correo, remitente o asunto"
                   value="@terminoBusqueda" @oninput="BuscarMensajes" />
        </label>
    </header>

@if (isLoading)
{
    <p class="inbox-status">Cargando mensajes...</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="inbox-error" role="alert">@errorMessage</p>
    }

       <div class="inbox-split @(mensajeSeleccionado is not null ? "has-selection" : string.Empty)">
        <section class="message-list-pane" aria-label="Lista de mensajes">
            @if (mensajes.Count == 0)
            {
                <p class="inbox-status">No hay mensajes en la bandeja de entrada.</p>
            }
            else
            {
                <ul class="message-list">
                    @foreach (var mensaje in mensajes)
                    {
                        var noLeido = !mensaje.Entry.IsRead;
                        var isSelected = mensajeSeleccionado?.Entry.Id == mensaje.Entry.Id;
                        <li class="message-row @(noLeido ? "unread" : string.Empty) @(isSelected ? "selected" : string.Empty)">
                            <button type="button"
                                    class="message-open"
                                    aria-current="@(isSelected ? "true" : null)"
                                    @onclick="() => SeleccionarMensaje(mensaje)">
                                <span class="message-sender">@NombreRemitente(mensaje.Message.SenderId)</span>
                                <span class="message-subject">@mensaje.Message.Subject</span>
                                <span class="message-preview">@VistaPrevia(mensaje.Message.Body)</span>
                            </button>
                            @if (mensajeSeleccionado is null)
                            {
                                <button type="button"
                                        class="message-action star-action @(mensaje.Entry.IsStarred ? "is-starred" : string.Empty)"
                                        aria-label="@(mensaje.Entry.IsStarred ? "Quitar de destacados" : "Marcar como destacado")"
                                        title="@(mensaje.Entry.IsStarred ? "Quitar de destacados" : "Marcar como destacado")"
                                        disabled="@togglingStarEntryIds.Contains(mensaje.Entry.Id)"
                                        @onclick="() => ToggleDestacado(mensaje.Entry)">
                                    <svg viewBox="0 0 24 24" fill="@(mensaje.Entry.IsStarred ? "currentColor" : "none")"
                                         stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                                         stroke-linejoin="round" aria-hidden="true">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                    </svg>
                                </button>
                                <details class="label-menu">
                                    <summary class="message-action label-action"
                                             aria-label="Asignar etiqueta al mensaje"
                                             title="@(mensaje.Entry.Label is null ? "Asignar etiqueta" : $"Etiqueta: {mensaje.Entry.Label}")">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z" />
                                            <circle cx="7.5" cy="7.5" r="1" />
                                        </svg>
                                    </summary>
                                    <div class="label-menu-panel">
                                        <label>
                                            <span>Etiqueta</span>
                                            <select value="@EtiquetaElegidaEnMenu(mensaje.Entry)"
                                                    @onchange="args => CambiarEtiquetaSeleccionada(mensaje.Entry.Id, args)"
                                                    aria-label="Seleccionar etiqueta existente">
                                                <option value="">Sin etiqueta</option>
                                                @foreach (var etiqueta in etiquetas)
                                                {
                                                    <option value="@etiqueta">@etiqueta</option>
                                                }
                                            </select>
                                        </label>
                                        <button type="button"
                                                class="label-apply-button"
                                                disabled="@assigningLabelEntryIds.Contains(mensaje.Entry.Id)"
                                                @onclick="() => AplicarEtiqueta(mensaje.Entry)">
                                            Aplicar
                                        </button>
                                        <label>
                                            <span>Nueva etiqueta</span>
                                            <input type="text"
                                                   maxlength="80"
                                                   placeholder="Escribe una etiqueta"
                                                   value="@EtiquetaNueva(mensaje.Entry.Id)"
                                                   @oninput="args => CambiarEtiquetaNueva(mensaje.Entry.Id, args)"
                                                   aria-label="Escribir nueva etiqueta" />
                                        </label>
                                        <button type="button"
                                                class="label-apply-button"
                                                disabled="@assigningLabelEntryIds.Contains(mensaje.Entry.Id)"
                                                @onclick="() => AplicarEtiquetaNueva(mensaje.Entry)">
                                            Crear y asignar
                                        </button>
                                    </div>
                                </details>
                                <button type="button"
                                        class="message-action delete-action"
                                        aria-label="Mover a papelera"
                                        title="Mover a papelera"
                                        disabled="@movingEntryIds.Contains(mensaje.Entry.Id)"
                                        @onclick="() => SolicitarConfirmacionPapelera(mensaje.Entry.Id)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                                         aria-hidden="true">
                                        <path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m4 4v6m6-6v6" />
                                    </svg>
                                </button>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="message-detail" aria-label="Mensaje seleccionado">
            @if (mensajeSeleccionado is null)
            {
                <div class="empty-message">
                    <span>Selecciona un mensaje para leerlo</span>
                </div>
            }
            else
            {
                var seleccionado = mensajeSeleccionado.Value;
                <div class="detail-toolbar" aria-label="Acciones del mensaje">
                    <button type="button"
                            class="detail-toolbar-button star-action @(seleccionado.Entry.IsStarred ? "is-starred" : string.Empty)"
                            aria-label="@(seleccionado.Entry.IsStarred ? "Quitar de destacados" : "Marcar como destacado")"
                            title="@(seleccionado.Entry.IsStarred ? "Quitar de destacados" : "Marcar como destacado")"
                            disabled="@togglingStarEntryIds.Contains(seleccionado.Entry.Id)"
                            @onclick="() => ToggleDestacado(seleccionado.Entry)">
                        <svg viewBox="0 0 24 24" fill="@(seleccionado.Entry.IsStarred ? "currentColor" : "none")"
                             stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                             stroke-linejoin="round" aria-hidden="true">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                        </svg>
                    </button>
                    <details class="label-menu detail-label-menu">
                        <summary class="detail-toolbar-button label-action"
                                 aria-label="Asignar etiqueta al mensaje"
                                 title="@(seleccionado.Entry.Label is null ? "Asignar etiqueta" : $"Etiqueta: {seleccionado.Entry.Label}")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z" />
                                <circle cx="7.5" cy="7.5" r="1" />
                            </svg>
                        </summary>
                        <div class="label-menu-panel">
                            <label>
                                <span>Etiqueta</span>
                                <select value="@EtiquetaElegidaEnMenu(seleccionado.Entry)"
                                        @onchange="args => CambiarEtiquetaSeleccionada(seleccionado.Entry.Id, args)"
                                        aria-label="Seleccionar etiqueta existente">
                                    <option value="">Sin etiqueta</option>
                                    @foreach (var etiqueta in etiquetas)
                                    {
                                        <option value="@etiqueta">@etiqueta</option>
                                    }
                                </select>
                            </label>
                            <button type="button"
                                    class="label-apply-button"
                                    disabled="@assigningLabelEntryIds.Contains(seleccionado.Entry.Id)"
                                    @onclick="() => AplicarEtiqueta(seleccionado.Entry)">
                                Aplicar
                            </button>
                            <label>
                                <span>Nueva etiqueta</span>
                                <input type="text"
                                       maxlength="80"
                                       placeholder="Escribe una etiqueta"
                                       value="@EtiquetaNueva(seleccionado.Entry.Id)"
                                       @oninput="args => CambiarEtiquetaNueva(seleccionado.Entry.Id, args)"
                                       aria-label="Escribir nueva etiqueta" />
                            </label>
                            <button type="button"
                                    class="label-apply-button"
                                    disabled="@assigningLabelEntryIds.Contains(seleccionado.Entry.Id)"
                                    @onclick="() => AplicarEtiquetaNueva(seleccionado.Entry)">
                                Crear y asignar
                            </button>
                        </div>
                    </details>
                    <button type="button"
                            class="detail-toolbar-button delete-action"
                            aria-label="Mover a papelera"
                            title="Mover a papelera"
                            disabled="@movingEntryIds.Contains(seleccionado.Entry.Id)"
                            @onclick="() => SolicitarConfirmacionPapelera(seleccionado.Entry.Id)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true">
                            <path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m4 4v6m6-6v6" />
                        </svg>
                    </button>
                </div>
                <header class="detail-header">
                    <h2>@seleccionado.Message.Subject</h2>
                </header>
                <div class="detail-sender">
                    <div class="sender-avatar" aria-hidden="true">@Iniciales(remitenteNombre)</div>
                    <div class="sender-summary">
                        <strong>@remitenteNombre</strong>
                        <span>@remitenteEmail</span>
                    </div>
                    <time datetime="@seleccionado.Message.CreatedAt.ToString("O")">
                        @seleccionado.Message.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                    </time>
                </div>
                <article class="detail-body">@seleccionado.Message.Body</article>
                <div class="detail-actions">
                    <button type="button" class="detail-button primary-action" @onclick="Responder">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M9 14 4 9l5-5" />
                            <path d="M4 9h10a6 6 0 0 1 0 12h-2" />
                        </svg>
                        Responder
                    </button>
                    <button type="button" class="detail-button" @onclick="Reenviar">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="m15 14 5-5-5-5" />
                            <path d="M20 9H10a6 6 0 0 0 0 12h2" />
                        </svg>
                        Reenviar
                    </button>
                    <button type="button" class="detail-button">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6" />
                        </svg>
                        Archivar
                    </button>
                </div>
            }
        </section>
    </div>

    @if (entradaPendienteDeEliminar is { } mailboxEntryId)
    {
        <div class="confirmation-backdrop">
            <section class="confirmation-dialog"
                     role="alertdialog"
                     aria-modal="true"
                     aria-labelledby="delete-confirmation-title"
                     aria-describedby="delete-confirmation-message">
                <h2 id="delete-confirmation-title">Confirmar eliminación</h2>
                <p id="delete-confirmation-message">¿Seguro que quieres eliminar este mensaje?</p>
                <div class="confirmation-actions">
                    <button type="button" class="detail-button" @onclick="CancelarEliminar">
                        Cancelar
                    </button>
                    <button type="button"
                            class="detail-button destructive-action"
                            disabled="@movingEntryIds.Contains(mailboxEntryId)"
                            @onclick="ConfirmarMoverAPapelera">
                        Eliminar
                    </button>
                </div>
            </section>
        </div>
    }
}
</section>

@code {
    private List<(MailboxEntry Entry, Message Message)> mensajes = [];
    private List<string> etiquetas = [];
    private HashSet<Guid> movingEntryIds = [];
    private HashSet<Guid> togglingStarEntryIds = [];
    private HashSet<Guid> assigningLabelEntryIds = [];
    private Dictionary<Guid, string> etiquetasSeleccionadasPorEntrada = [];
    private Dictionary<Guid, string> etiquetasNuevasPorEntrada = [];
    private bool isLoading = true;
    private string terminoBusqueda = string.Empty;
    private string? errorMessage;
    private Guid? entradaPendienteDeEliminar;
    private int searchRequestId;
    private int loadRequestId;
    private int selectionRequestId;
    private string? ultimaEtiquetaCargada;
    private bool bandejaInicializada;
    private (MailboxEntry Entry, Message Message)? mensajeSeleccionado;
    private string remitenteNombre = "Remitente";
    private string remitenteEmail = string.Empty;
    private Dictionary<Guid, string> nombresRemitentes = [];

    [SupplyParameterFromQuery(Name = "etiqueta")]
    public string? EtiquetaSeleccionada { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (bandejaInicializada &&
            string.Equals(ultimaEtiquetaCargada, EtiquetaSeleccionada, StringComparison.Ordinal))
        {
            return;
        }

        bandejaInicializada = true;
        ultimaEtiquetaCargada = EtiquetaSeleccionada;
        terminoBusqueda = string.Empty;
        searchRequestId++;
        etiquetasSeleccionadasPorEntrada.Clear();
        etiquetasNuevasPorEntrada.Clear();
        var requestId = ++loadRequestId;
        isLoading = true;
        errorMessage = null;

        try
        {
            await SupabaseService.Initialization;
            if (!Guid.TryParse(SupabaseService.Client.Auth.CurrentSession?.User?.Id, out var userId))
            {
                throw new InvalidOperationException("Se requiere una sesión autenticada para consultar la bandeja.");
            }

            var resultados = string.IsNullOrWhiteSpace(EtiquetaSeleccionada)
                ? await SupabaseService.ObtenerBandejaEntradaAsync()
                : await SupabaseService.ObtenerMensajesConEtiquetaAsync(userId, EtiquetaSeleccionada);
            var nombres = await SupabaseService.ObtenerNombresRemitentesAsync(
                resultados.Select(mensaje => mensaje.Message.SenderId));

            if (requestId == loadRequestId)
            {
                mensajes = resultados;
                nombresRemitentes = nombres;
                LimpiarSeleccionSiNoExiste(resultados);
            }
        }
        catch (InvalidOperationException exception)
        {
            if (requestId == loadRequestId)
            {
                Logger.LogWarning(exception, "No hay una sesión válida para consultar la bandeja.");
                Navigation.NavigateTo("/login");
            }
        }
        catch (HttpRequestException exception)
        {
            if (requestId == loadRequestId)
            {
                Logger.LogError(exception, "No se pudo cargar la bandeja desde Supabase.");
                errorMessage = "No se pudo cargar la bandeja. Inténtalo de nuevo.";
            }
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            if (requestId == loadRequestId)
            {
                Logger.LogError(exception, "Supabase devolvió un error al consultar la bandeja.");
                errorMessage = "Ocurrió un error al consultar tus mensajes.";
            }
        }
        finally
        {
            if (requestId == loadRequestId)
            {
                isLoading = false;
            }
        }
    }

    private void LimpiarSeleccionSiNoExiste(List<(MailboxEntry Entry, Message Message)> resultados)
    {
        if (mensajeSeleccionado is { } seleccionado &&
            resultados.All(mensaje => mensaje.Entry.Id != seleccionado.Entry.Id))
        {
            selectionRequestId++;
            mensajeSeleccionado = null;
        }
    }

    private async Task SeleccionarMensaje((MailboxEntry Entry, Message Message) seleccion)
    {
        var requestId = ++selectionRequestId;
        mensajeSeleccionado = seleccion;
        remitenteNombre = NombreRemitente(seleccion.Message.SenderId);
        remitenteEmail = string.Empty;
        errorMessage = null;

        try
        {
            var perfil = await SupabaseService.ObtenerPerfilPorIdAsync(seleccion.Message.SenderId);
            if (requestId != selectionRequestId)
            {
                return;
            }

            if (perfil is not null)
            {
                remitenteNombre = string.IsNullOrWhiteSpace(perfil.FullName)
                    ? perfil.Email
                    : perfil.FullName;
                remitenteEmail = perfil.Email;
                nombresRemitentes[perfil.Id] = remitenteNombre;
            }

            if (!seleccion.Entry.IsRead)
            {
                await SupabaseService.MarcarComoLeido(seleccion.Entry.Id);
                seleccion.Entry.IsRead = true;
            }
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "No hay una sesión válida para cargar el mensaje {MessageId}.", seleccion.Message.Id);
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo cargar el remitente o marcar como leído el mensaje {MessageId}.", seleccion.Message.Id);
            errorMessage = "No se pudo cargar toda la información del mensaje.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase devolvió un error al abrir el mensaje {MessageId}.", seleccion.Message.Id);
            errorMessage = "No se pudo cargar toda la información del mensaje.";
        }
    }

    private async Task BuscarMensajes(ChangeEventArgs args)
    {
        terminoBusqueda = args.Value?.ToString() ?? string.Empty;
        var requestId = ++searchRequestId;
        errorMessage = null;

        try
        {
            List<(MailboxEntry Entry, Message Message)> resultados;
            if (string.IsNullOrWhiteSpace(terminoBusqueda))
            {
                if (string.IsNullOrWhiteSpace(EtiquetaSeleccionada))
                {
                    resultados = await SupabaseService.ObtenerBandejaEntradaAsync();
                }
                else
                {
                    await SupabaseService.Initialization;
                    if (!Guid.TryParse(SupabaseService.Client.Auth.CurrentSession?.User?.Id, out var userId))
                    {
                        throw new InvalidOperationException("Se requiere una sesión autenticada para consultar la bandeja.");
                    }

                    resultados = await SupabaseService.ObtenerMensajesConEtiquetaAsync(userId, EtiquetaSeleccionada);
                }
            }
            else
            {
                await SupabaseService.Initialization;
                if (!Guid.TryParse(SupabaseService.Client.Auth.CurrentSession?.User?.Id, out var userId))
                {
                    throw new InvalidOperationException("Se requiere una sesión autenticada para buscar mensajes.");
                }

                resultados = await SupabaseService.BuscarMensajes(
                    userId,
                    terminoBusqueda,
                    "inbox",
                    EtiquetaSeleccionada);
            }

            var nombres = await SupabaseService.ObtenerNombresRemitentesAsync(
                resultados.Select(mensaje => mensaje.Message.SenderId));
            if (requestId == searchRequestId)
            {
                mensajes = resultados;
                nombresRemitentes = nombres;
                if (mensajeSeleccionado is { } seleccionado &&
                    resultados.All(mensaje => mensaje.Entry.Id != seleccionado.Entry.Id))
                {
                    selectionRequestId++;
                    mensajeSeleccionado = null;
                }
            }
        }
        catch (InvalidOperationException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogWarning(exception, "No hay una sesión válida para buscar en la bandeja.");
                Navigation.NavigateTo("/login");
            }
        }
        catch (HttpRequestException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogError(exception, "No se pudo buscar en la bandeja desde Supabase.");
                errorMessage = "No se pudo buscar en la bandeja. Inténtalo de nuevo.";
            }
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            if (requestId == searchRequestId)
            {
                Logger.LogError(exception, "Supabase devolvió un error al buscar en la bandeja.");
                errorMessage = "Ocurrió un error al buscar tus mensajes.";
            }
        }
    }

    private string EtiquetaElegidaEnMenu(MailboxEntry entry) =>
        etiquetasSeleccionadasPorEntrada.TryGetValue(entry.Id, out var etiqueta)
            ? etiqueta
            : entry.Label ?? string.Empty;

    private void CambiarEtiquetaSeleccionada(Guid mailboxEntryId, ChangeEventArgs args)
    {
        etiquetasSeleccionadasPorEntrada[mailboxEntryId] = args.Value?.ToString() ?? string.Empty;
    }

    private string EtiquetaNueva(Guid mailboxEntryId) =>
        etiquetasNuevasPorEntrada.TryGetValue(mailboxEntryId, out var etiqueta) ? etiqueta : string.Empty;

    private void CambiarEtiquetaNueva(Guid mailboxEntryId, ChangeEventArgs args)
    {
        etiquetasNuevasPorEntrada[mailboxEntryId] = args.Value?.ToString() ?? string.Empty;
    }

    private Task AplicarEtiqueta(MailboxEntry entry) =>
        AsignarEtiquetaAEntradaAsync(entry, EtiquetaElegidaEnMenu(entry));

    private Task AplicarEtiquetaNueva(MailboxEntry entry)
    {
        var etiqueta = EtiquetaNueva(entry.Id).Trim();
        if (string.IsNullOrWhiteSpace(etiqueta))
        {
            errorMessage = "Escribe un nombre para la nueva etiqueta.";
            return Task.CompletedTask;
        }

        return CrearYAsignarEtiquetaAsync(entry, etiqueta);
    }

    private async Task CrearYAsignarEtiquetaAsync(MailboxEntry entry, string etiqueta)
    {
        var etiquetaNormalizada = etiqueta.Trim();
        if (etiquetaNormalizada.Length > 80)
        {
            errorMessage = "La etiqueta no puede superar los 80 caracteres.";
            return;
        }

        try
        {
            await SupabaseService.CrearEtiqueta(etiquetaNormalizada);
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "La sesión no es válida para crear la etiqueta.");
            Navigation.NavigateTo("/login");
            return;
        }
        catch (ArgumentException exception)
        {
            Logger.LogWarning(exception, "Se intentó crear una etiqueta no válida.");
            errorMessage = "La etiqueta debe contener entre 1 y 80 caracteres.";
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo guardar la etiqueta {Label} en Supabase.", etiquetaNormalizada);
            errorMessage = "No se pudo guardar la etiqueta. Inténtalo de nuevo.";
            return;
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase rechazó guardar la etiqueta {Label}.", etiquetaNormalizada);
            errorMessage = "No se pudo guardar la etiqueta. Inténtalo de nuevo.";
            return;
        }

        await AsignarEtiquetaAEntradaAsync(entry, etiquetaNormalizada);
    }

    private async Task AsignarEtiquetaAEntradaAsync(MailboxEntry entry, string etiqueta)
    {
        if (!assigningLabelEntryIds.Add(entry.Id))
        {
            return;
        }

        errorMessage = null;
        try
        {
            var etiquetaNormalizada = etiqueta.Trim();
            await SupabaseService.AsignarEtiqueta(entry.Id, etiquetaNormalizada);
            entry.Label = string.IsNullOrWhiteSpace(etiquetaNormalizada) ? null : etiquetaNormalizada;
            etiquetasSeleccionadasPorEntrada.Remove(entry.Id);
            etiquetasNuevasPorEntrada.Remove(entry.Id);

            if (entry.Label is not null && !etiquetas.Contains(entry.Label, StringComparer.Ordinal))
            {
                etiquetas.Add(entry.Label);
                etiquetas = etiquetas.OrderBy(label => label, StringComparer.OrdinalIgnoreCase).ToList();
            }

            if (!string.IsNullOrWhiteSpace(EtiquetaSeleccionada) &&
                !string.Equals(entry.Label, EtiquetaSeleccionada, StringComparison.Ordinal))
            {
                mensajes.RemoveAll(mensaje => mensaje.Entry.Id == entry.Id);
                if (mensajeSeleccionado?.Entry.Id == entry.Id)
                {
                    selectionRequestId++;
                    mensajeSeleccionado = null;
                }
            }
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "La sesión no es válida para asignar una etiqueta a la entrada {MailboxEntryId}.", entry.Id);
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo asignar una etiqueta a la entrada {MailboxEntryId}.", entry.Id);
            errorMessage = "No se pudo actualizar la etiqueta. Inténtalo de nuevo.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase rechazó asignar una etiqueta a la entrada {MailboxEntryId}.", entry.Id);
            errorMessage = "No se pudo actualizar la etiqueta. Inténtalo de nuevo.";
        }
        finally
        {
            assigningLabelEntryIds.Remove(entry.Id);
        }
    }

    private async Task ToggleDestacado(MailboxEntry entry)
    {
        if (!togglingStarEntryIds.Add(entry.Id))
        {
            return;
        }

        errorMessage = null;
        var nuevoEstado = !entry.IsStarred;
        try
        {
            await SupabaseService.ToggleDestacado(entry.Id, nuevoEstado);
            entry.IsStarred = nuevoEstado;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo actualizar el destacado para la entrada {MailboxEntryId}.", entry.Id);
            errorMessage = "No se pudo actualizar el mensaje destacado. Inténtalo de nuevo.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase rechazó actualizar el destacado para la entrada {MailboxEntryId}.", entry.Id);
            errorMessage = "No se pudo actualizar el mensaje destacado. Inténtalo de nuevo.";
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "La sesión no es válida para actualizar el destacado de la entrada {MailboxEntryId}.", entry.Id);
            Navigation.NavigateTo("/login");
        }
        finally
        {
            togglingStarEntryIds.Remove(entry.Id);
        }
    }

    private async Task MoverAPapelera(Guid mailboxEntryId)
    {
        if (!movingEntryIds.Add(mailboxEntryId))
        {
            return;
        }

        errorMessage = null;
        try
        {
            await SupabaseService.MoverAPapelera(mailboxEntryId);
            mensajes.RemoveAll(mensaje => mensaje.Entry.Id == mailboxEntryId);
            if (mensajeSeleccionado?.Entry.Id == mailboxEntryId)
            {
                selectionRequestId++;
                mensajeSeleccionado = null;
            }
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "No se pudo mover la entrada {MailboxEntryId} a la papelera.", mailboxEntryId);
            errorMessage = "No se pudo mover el mensaje a la papelera. Inténtalo de nuevo.";
        }
        catch (Supabase.Postgrest.Exceptions.PostgrestException exception)
        {
            Logger.LogError(exception, "Supabase rechazó mover la entrada {MailboxEntryId} a la papelera.", mailboxEntryId);
            errorMessage = "No se pudo mover el mensaje a la papelera. Inténtalo de nuevo.";
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "La sesión no es válida para mover la entrada {MailboxEntryId}.", mailboxEntryId);
            Navigation.NavigateTo("/login");
        }
        finally
        {
            movingEntryIds.Remove(mailboxEntryId);
        }
    }

    private void SolicitarConfirmacionPapelera(Guid mailboxEntryId)
    {
        entradaPendienteDeEliminar = mailboxEntryId;
    }

    private void CancelarEliminar()
    {
        entradaPendienteDeEliminar = null;
    }

    private async Task ConfirmarMoverAPapelera()
    {
        if (entradaPendienteDeEliminar is not { } mailboxEntryId)
        {
            return;
        }

        entradaPendienteDeEliminar = null;
        await MoverAPapelera(mailboxEntryId);
    }

    private static string VistaPrevia(string cuerpo)
    {
        const int longitudMaxima = 120;
        return cuerpo.Length <= longitudMaxima
            ? cuerpo
            : $"{cuerpo[..longitudMaxima]}…";
    }

    private static string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length switch
        {
            0 => "?",
            1 => partes[0][..1].ToUpperInvariant(),
            _ => string.Concat(partes[0][..1], partes[^1][..1]).ToUpperInvariant()
        };
    }

    private string NombreRemitente(Guid senderId) =>
        nombresRemitentes.TryGetValue(senderId, out var nombre) ? nombre : senderId.ToString();

    private void Responder()
    {
        if (mensajeSeleccionado is not { } seleccionado)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(remitenteEmail))
        {
            errorMessage = "No se pudo obtener el correo del remitente para responder.";
            return;
        }

        var subject = seleccionado.Message.Subject.StartsWith("Re: ", StringComparison.OrdinalIgnoreCase)
            ? seleccionado.Message.Subject
            : $"Re: {seleccionado.Message.Subject}";

        NavigateToCompose(new Dictionary<string, object?>
        {
            ["destinatario"] = remitenteEmail,
            ["asunto"] = subject,
            ["parentMessageId"] = seleccionado.Message.Id
        });
    }

    private void Reenviar()
    {
        if (mensajeSeleccionado is not { } seleccionado)
        {
            return;
        }

        var subject = seleccionado.Message.Subject.StartsWith("Fwd: ", StringComparison.OrdinalIgnoreCase)
            ? seleccionado.Message.Subject
            : $"Fwd: {seleccionado.Message.Subject}";

        NavigateToCompose(new Dictionary<string, object?>
        {
            ["asunto"] = subject,
            ["cuerpo"] = $"---- Mensaje reenviado ----\n{seleccionado.Message.Body}"
        });
    }

    private void NavigateToCompose(IReadOnlyDictionary<string, object?> queryParameters)
    {
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters("/redactar", queryParameters));
    }
}
